function Shots.fire(id, s, name, hitbox, point, now)
    local S = Shots
    local c = S.cursor % S.size + 1
    S.cursor = c
    local rec = S.pool[c]
    if rec.id ~= nil and S.byId[rec.id] == rec then S.byId[rec.id] = nil end
    rec.used = true
    rec.id = id
    rec.t = now
    rec.s = s
    rec.name = name
    rec.hitbox = hitbox
    rec.point = point
    rec.head = isHead(hitbox)
    rec.text = nil
    rec.vpos = nil
    rec.arms = nil
    if s ~= nil then rec.vpos = s.pos end
    if id ~= nil then
        S.byId[id] = rec
        S.ids = true
    end
    if s ~= nil and Resolver.active and cfg.res then
        rec.life = s.life
        rec.legit = s.legit
        rec.hyp = s.hyp
        rec.ctx = s.ctx
        rec.rev = s.rev[s.ctx]
        rec.ang = s.ang
        rec.lby = s.lby
        rec.ref = s.ref
        rec.retry = s.hyp ~= 0 and s.pin == s.hyp and now < s.pinUntil
        rec.arms = s.arms
        if s.hyp == 0 then
            rec.ang = s.yaw
            local ok, tgt = pcall(rage.get_target)
            if ok and type(tgt) == "table" then
                local yaw = tgt.resolved_yaw_deg
                if type(yaw) == "number" and yaw - yaw == 0 and tgt.player ~= nil and keyOf(tgt.player) == s.key then
                    rec.ang = wrap180(yaw)
                end
            end
        end
        local a, b = rec.ca, s.ca
        for h = 1, NH do a[h] = b[h] end
        if s.hyp ~= 0 then rec.text = Resolver.describe(s) end
        return rec
    else
        rec.hyp = 0
        rec.life = -1
        rec.retry = false
    end
    return rec
end

function Shots.take(id, s, now)
    local S = Shots
    local rec = nil
    if id ~= nil then rec = S.byId[id] end
    if rec == nil and not (id ~= nil and id ~= 0 and S.ids) then
        local pool = S.pool
        local oldest = nil
        for i = 1, S.size do
            local r = pool[i]
            if r.used and now - r.t <= 2 and (s == nil or r.s == nil or r.s == s) then
                if oldest == nil or r.t < oldest.t then oldest = r end
            end
        end
        rec = oldest
    end
    if rec == nil or not rec.used then return nil end
    rec.used = false
    if rec.id ~= nil and S.byId[rec.id] == rec then S.byId[rec.id] = nil end
    if now - rec.t > 5 then return nil end
    return rec
end

