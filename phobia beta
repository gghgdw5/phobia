        end
    elseif act == "share_send" then
        if not Chat.canSay then
            announce("No chat member in this sandbox", 3, now)
        else
            local code = Cloud.shareCode()
            if Chat.say(code) then
                announce("Share code sent to chat", 2, now)
            else
                announce("Could not send the code", 4, now)
            end
        end
    elseif act == "slot_load" then
        local slot = Menu.slotLoad()
        if slot ~= nil then
            announce("Config loaded: " .. slot, 2, now)
        else
