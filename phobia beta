local function tickDamage(R, tickN)
    local force = nil
    if R.peek then
        force = cfg.peek_dmg
    elseif cfg.dmg and Bind.dmg_key then
        force = cfg.dmg_val
    end
    if force ~= R.force then
        R.force = force
        R.resample = true
    end
    if force ~= nil then
        local want = force
        if cfg.lethal then
            local ts = Resolver.target
            if ts ~= nil and ts.alive then
                local hp = ts.hp
                if hp > 0 and hp < want then want = math_ceil(hp) end
            end
        end
        if want ~= R.md or tickN % 32 == 0 then
            rage.override_min_damage(want)
            R.md = want
            R.mdTick = tickN
        end
        return
    end
    if not cfg.lethal then
        if R.md ~= nil then
            rage.override_min_damage(nil)
            R.md = nil
        end
        return
    end
    if R.md == nil then
        if R.resample or R.baseMd == nil or tickN % 8 == 0 then
            R.resample = false
            local v = rage.get_min_damage()
            if type(v) == "number" then R.baseMd = v end
        end
    elseif tickN - R.mdTick >= 48 or tickN < R.mdTick then
        rage.override_min_damage(nil)
        R.md = nil
        R.resample = true
        return
    end
    local want = nil
    local ts = Resolver.target
    local base = R.baseMd
    if ts ~= nil and ts.alive and base ~= nil then
        local hp = ts.hp
        if hp > 0 and hp < base then want = math_ceil(hp) end
    end
    if want ~= R.md then
        if R.md == nil then R.mdTick = tickN end
        rage.override_min_damage(want)
        R.md = want
    end
end

function Rage.tick(now, tickN)
    local R = Rage

    if cfg.lethal or cfg.nshc or cfg.xhair then
        if now >= R.wepAt then
            R.wepAt = now + 0.25
            readWeapon()
            local thr = 0
            if cfg.lethal then
                local name = R.wepName
                local avg, n = R.bodyDmg[name], R.bodyN[name]
                if avg ~= nil and n >= 2 then thr = avg * 0.85 end
            end
            R.lethalThr = thr
        end
        if not cfg.lethal then R.lethalThr = 0 end
    else
        R.lethalThr = 0
        R.optic = false
    end

    R.peek = cfg.peek == true and Bind.peek_key == true and hasTarget()

    if R.canHc then
        local want = nil
        local ts = Resolver.target
        if R.peek then
            want = cfg.peek_hc
        elseif cfg.airhc and not State.grounded then
            want = cfg.airhc_val
        elseif cfg.nshc and R.optic then
            if R.canScope and tickN % 4 == 0 then
                local ok, scoped = pcall(weapon.is_scoped)
                if ok then R.noscope = scoped ~= true else R.canScope = false end
            end
            if R.noscope then want = cfg.nshc_val end
        end
        if want == nil and ts ~= nil and ts.alive then
            if cfg.crouch and ts.crouch then
                want = cfg.crouch_val
            elseif cfg.adapthc and ts.hcBonus > 0 and R.baseHc ~= nil then
                want = R.baseHc + ts.hcBonus
                if want > 100 then want = 100 end
            end
        end
        if want == nil and R.hc == nil and cfg.adapthc and R.canBase and tickN % 16 == 0 then
            local ok, v = pcall(rage.get_hitchance)
            if ok and type(v) == "number" then R.baseHc = v end
        end
        if want ~= R.hc or (want ~= nil and tickN % 16 == 0) then
            rage.override_hitchance(want)
            R.hc = want
        end
    end

    if R.canMd then tickDamage(R, tickN) end

    if R.canFB then
        local want = Bind.fbaim == true
        if want ~= R.fb then
            if pcall(rage.override_force_baim, want) then R.fb = want else R.canFB = false end
        end
    end
    if R.canFS then
        local want = Bind.fsafe == true
        if want ~= R.fs then
            if pcall(rage.override_force_safe_point, want) then R.fs = want else R.canFS = false end
        end
    end
end

function Rage.learn(hitbox, damage, hpLeft)
    if type(damage) ~= "number" or damage <= 0 then return end
    if type(hpLeft) ~= "number" or hpLeft <= 0 then return end
    if not isBody(hitbox) then return end
    local name = Rage.wepName
    if name == "" then return end
    local avg = Rage.bodyDmg[name]
    if avg == nil then
        Rage.bodyDmg[name] = damage
        Rage.bodyN[name] = 1
    else
        Rage.bodyDmg[name] = avg + (damage - avg) * 0.35
        Rage.bodyN[name] = Rage.bodyN[name] + 1
    end
end

function Rage.release()
