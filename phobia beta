    if D.busy <= 0 then return end
    local busy = 0
    for i = 1, 5 do
        local m = D.pool[i]
        if m.on then
            local age = now - m.t0
            if age >= 0.9 or not cfg.dmgnum then
                m.on = false
                m.label.Visible = false
            else
                busy = busy + 1
                local u = 1 - age / 0.9
                local rise = math_floor((1 - u * u * u) * 30 + 0.5)
                if rise ~= m.rise then
                    m.rise = rise
                    m.label.Position = UDim2.new(0, m.x, 0, m.y - rise)
                end
                local alpha = 1
                if age < 0.08 then
                    alpha = age / 0.08
                elseif age > 0.5 then
                    alpha = 1 - (age - 0.5) / 0.4
                end
                local step = math_floor(alpha * 12 + 0.5)
                if step ~= m.step then
                    m.step = step
                    m.label.TextTransparency = 1 - step / 12
                    m.label.TextStrokeTransparency = 1 - step / 24
                end
            end
        end
    end
    D.busy = busy
end

