    if R.hc ~= nil and R.canHc then pcall(rage.override_hitchance, nil) end
    if R.md ~= nil and R.canMd then pcall(rage.override_min_damage, nil) end
    if R.fb and R.canFB then pcall(rage.override_force_baim, false) end
    if R.fs and R.canFS then pcall(rage.override_force_safe_point, false) end
    R.hc = nil
