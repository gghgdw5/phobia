local function recalcBonus(h)
    local hit, miss = G_HIT[h], G_MISS[h]
    local n = hit + miss
    local conf = n >= 8 and 1 or n / 8
    local b = G_WEIGHT * ((hit + 1) / (n + 2) - 0.5) * conf
