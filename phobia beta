local Fx = {
    canRing = r3d ~= nil and type(r3d.ring) == "function",
    canLine = r3d ~= nil and type(r3d.line) == "function",
    pool = {}, n = 0, cursor = 0,
    grounded = true, airAt = 0, landAt = 0, jumpAt = 0, stepAt = 0, lastTick = 0,
    jumped = false, groundAt = 0, chain = 0, lastVY = nil,
}
do
local KILL_MODES = { Ascend = 1, Shockwave = 2, Pillar = 3, Helix = 4, Burst = 5, Lightning = 6, Tornado = 7, Nova = 8 }
local HIT_MODES = { Spark = 1, Ring = 2, Cross = 3 }
local RING_STYLES = { Glow = 1, Double = 2, Ripple = 3 }

local DIRS = {
    0.312, 0.95, 0.0, -0.379, 0.858, 0.347, 0.056, 0.765, -0.641, 0.45, 0.673, 0.587, -0.802, 0.581, -0.142,
    0.736, 0.488, -0.468, -0.238, 0.396, 0.887, -0.439, 0.304, -0.845, 0.918, 0.212, 0.335, -0.918, 0.119, 0.379,
    0.424, 0.027, -0.905, 0.299, -0.065, 0.952, -0.854, -0.158, -0.495, 0.946, -0.25, -0.208,
}

for i = 1, 12 do
    Fx.pool[i] = { on = false, kind = 0, mode = 1, t0 = 0, life = 1, x = 0, y = 0, z = 0, scale = 1, seed = 0, ox = {}, oz = {} }
end

local ring, line = nil, nil
if Fx.canRing then ring = r3d.ring end
if Fx.canLine then line = r3d.line end

local function outCubic(u)
    local v = 1 - u
    return 1 - v * v * v
end

local function outQuint(u)
    local v = 1 - u
    return 1 - v * v * v * v * v
end

local function fade(u)
    local v = 1 - u
    return v * v * (3 - 2 * v)
end

local function glowRing(x, y, z, radius, thick, alpha, color)
    if alpha <= 0.02 then return end
    local p = Vector3.new(x, y, z)
    ring(p, radius, thick, color, 1 - alpha, true)
    ring(p, radius, thick * 2.8, color, 1 - alpha * 0.38, true)
    ring(p, radius, thick * 5.5, color, 1 - alpha * 0.15, true)
end

local function thinRing(x, y, z, radius, thick, alpha, color)
    if alpha <= 0.02 then return end
    ring(Vector3.new(x, y, z), radius, thick, color, 1 - alpha, true)
end

local function seg(ax, ay, az, bx, by, bz, thick, alpha, color)
    if alpha <= 0.02 then return end
    line(Vector3.new(ax, ay, az), Vector3.new(bx, by, bz), color, thick, 1 - alpha, true)
end

local function take(kind, mode, life, x, y, z, now)
    local F = Fx
    local c = F.cursor % 12 + 1
    F.cursor = c
    local m = F.pool[c]
    if not m.on then F.n = F.n + 1 end
    m.on = true
    m.kind = kind
    m.mode = mode
    m.life = life
    m.t0 = now
    m.x = x
    m.y = y
    m.z = z
    m.scale = 1
    m.seed = math_random() * 6.283185307179586
    return m
end

local function killAscend(m, age, color)
    local x, y, z = m.x, m.y, m.z
    for k = 0, 2 do
        local u = age / 0.82 - k * 0.09
        if u > 0 and u < 1 then
            local e = 1 - (1 - u) * (1 - u)
            ring(Vector3.new(x, y + 0.1 + e * 4.4, z), 0.8 + e * 1.8, 0.08, color, 0.1 + u * 0.9, true)
        end
    end
    if line ~= nil and age < 0.6 then
        local u = age / 0.6
        local e = outCubic(u)
        line(Vector3.new(x, y, z), Vector3.new(x, y + 4 + 12 * e, z), color, 0.1, 0.2 + u * 0.8, true)
    end
end

local function killShockwave(m, age, color)
    local x, y, z = m.x, m.y + 0.08, m.z
    for k = 0, 2 do
        local u = (age - k * 0.14) / 0.72
        if u > 0 and u < 1 then
            glowRing(x, y, z, 0.5 + outQuint(u) * 7.5, 0.05 + 0.13 * (1 - u), fade(u), color)
        end
    end
    if line ~= nil and age < 0.3 then
        local u = age / 0.3
        seg(x, y, z, x, y + 2 + 5 * outCubic(u), z, 0.26, fade(u) * 0.8, Theme.light)
    end
end

local function killPillar(m, age, color)
    local x, y, z = m.x, m.y, m.z
    local grow = age < 0.35 and outCubic(age / 0.35) or 1
    local a = age < 0.45 and 1 or fade((age - 0.45) / 0.65)
    local h = 17 * grow
    if line ~= nil then
        local spin = m.seed + age * 1.6
        for i = 0, 5 do
            local ang = spin + i * 1.0471975511965976
            local px, pz = x + math_cos(ang) * 0.85, z + math_sin(ang) * 0.85
            seg(px, y, pz, px, y + h, pz, 0.06, a * 0.85, color)
        end
        seg(x, y, z, x, y + h, z, 0.3, a * 0.3, Theme.light)
    end
    for k = 0, 1 do
        local u = (age - k * 0.22) / 0.8
        if u > 0 and u < 1 then
            thinRing(x, y + outCubic(u) * 16, z, 1.15, 0.07, fade(u), color)
        end
    end
    if age < 0.7 then
        local u = age / 0.7
        glowRing(x, y + 0.08, z, 1.2 + outQuint(u) * 1.6, 0.08, fade(u), color)
    end
end

local function killHelix(m, age, color)
    if line == nil then
        killAscend(m, age, color)
        return
    end
    local x, y, z = m.x, m.y, m.z
    local reveal = age < 0.55 and outCubic(age / 0.55) or 1
    local a = fade(age / 1.2)
    for strand = 0, 1 do
        local base = m.seed + strand * 3.141592653589793 + age * 4.2
        local px, py, pz = x + math_cos(base) * 2, y + 0.2, z + math_sin(base) * 2
        for i = 1, 16 do
            local s = i / 16
            if s > reveal then break end
            local ang = base + s * 8.2
            local rad = 2 - 0.75 * s
            local qx, qy, qz = x + math_cos(ang) * rad, y + 0.2 + s * 7.4, z + math_sin(ang) * rad
            if s + 0.0625 > reveal and reveal < 1 then
                seg(px, py, pz, qx, qy, qz, 0.14, a, Theme.light)
            else
                seg(px, py, pz, qx, qy, qz, 0.09, a * (1 - 0.5 * s), color)
            end
            px, py, pz = qx, qy, qz
        end
    end
    if age < 0.6 then
        local u = age / 0.6
        glowRing(x, y + 0.08, z, 1.3 + outQuint(u) * 1.5, 0.07, fade(u), color)
    end
end

local function killBurst(m, age, color)
    local x, y, z = m.x, m.y, m.z
    local u = age / 0.8
    local e = outQuint(u)
    local a = fade(u)
    if line ~= nil then
        local cy = y + 2.6
        local near, far = 0.5 + 6.2 * e, 0.5 + 6.2 * e + 0.3 + 1.7 * (1 - u)
        local cs, sn = math_cos(m.seed), math_sin(m.seed)
        for i = 0, 13 do
            local dx, dy, dz = DIRS[i * 3 + 1], DIRS[i * 3 + 2], DIRS[i * 3 + 3]
            local rx, rz = dx * cs - dz * sn, dx * sn + dz * cs
            seg(x + rx * near, cy + dy * near, z + rz * near, x + rx * far, cy + dy * far, z + rz * far, 0.07, a, i % 3 == 0 and Theme.light or color)
        end
    end
    glowRing(x, y + 0.08, z, 0.6 + e * 3.4, 0.09, a, color)
end

local function killLightning(m, age, color)
    local x, y, z = m.x, m.y, m.z
    if line ~= nil then
        local k = 0
        if age < 0.11 then
            k = 1
        elseif age > 0.15 and age < 0.25 then
            k = -0.7
        elseif age > 0.29 and age < 0.4 then
            k = 0.85
        end
        if k ~= 0 then
            local a = k == 1 and 1 or (k < 0 and 0.85 or 0.6)
            local ox, oz = m.ox, m.oz
            local px, py, pz = x, y + 27, z
            for i = 1, 9 do
                local f = i / 9
                local qx, qy, qz = x + ox[i] * k, y + 27 * (1 - f), z + oz[i] * k
                seg(px, py, pz, qx, qy, qz, 0.11, a, Theme.light)
                seg(px, py, pz, qx, qy, qz, 0.42, a * 0.28, color)
                px, py, pz = qx, qy, qz
            end
            local bx, by, bz = x + ox[4] * k, y + 27 * (1 - 4 / 9), z + oz[4] * k
            seg(bx, by, bz, bx + oz[6] * 1.6 * k, by - 4.5, bz - ox[6] * 1.6 * k, 0.07, a * 0.7, Theme.light)
        end
    end
    for i = 0, 1 do
        local u = (age - i * 0.1) / 0.6
        if u > 0 and u < 1 then
            glowRing(x, y + 0.08, z, 0.4 + outQuint(u) * 4.6, 0.1 * (1 - u) + 0.04, fade(u), color)
        end
    end
end

local function killTornado(m, age, color)
    local x, y, z = m.x, m.y, m.z
    local grow = age < 0.45 and outCubic(age / 0.45) or 1
    local a = fade(age / 1.3)
    local spin = m.seed + age * 9
    for k = 0, 8 do
        local f = k / 8
        local sway = 0.4 * f
        thinRing(x + math_sin(spin + k * 0.9) * sway, y + 0.15 + f * 7 * grow, z + math_cos(spin + k * 0.9) * sway,
            (0.45 + 2.4 * f) * (0.75 + 0.25 * grow), 0.07, a * (1 - 0.35 * f), color)
    end
end

local function killNova(m, age, color)
    local x, y, z = m.x, m.y + 2.6, m.z
    local u = age / 0.9
    local radius = 0.5 + outQuint(u) * 4.4
    local a = fade(u)
    glowRing(x, y, z, radius, 0.07, a, color)
    thinRing(x, y + radius * 0.5, z, radius * 0.866, 0.06, a * 0.85, color)
    thinRing(x, y + radius * 0.866, z, radius * 0.5, 0.06, a * 0.7, color)
    if radius * 0.5 < 2.5 then thinRing(x, y - radius * 0.5, z, radius * 0.866, 0.06, a * 0.85, color) end
    if radius * 0.866 < 2.5 then thinRing(x, y - radius * 0.866, z, radius * 0.5, 0.06, a * 0.7, color) end
end

local KILL = { killAscend, killShockwave, killPillar, killHelix, killBurst, killLightning, killTornado, killNova }
local KILL_LIFE = { 1.0, 1.0, 1.1, 1.2, 0.8, 0.75, 1.3, 0.9 }

function Fx.kill(x, y, z, now)
    if not Fx.canRing then return end
    local mode = KILL_MODES[cfg.kfx_mode]
    if mode == nil then mode = math_random(1, 8) end
    local m = take(1, mode, KILL_LIFE[mode], x, y, z, now)
    if mode == 6 then
        for i = 1, 9 do
            local k = i == 9 and 0 or 1
            m.ox[i] = (math_random() * 2 - 1) * 1.5 * k
            m.oz[i] = (math_random() * 2 - 1) * 1.5 * k
        end
    end
end

local function hitSpark(m, age, color)
    if line == nil then return end
    local x, y, z = m.x, m.y, m.z
    local u = age / 0.42
    local e = outQuint(u)
    local a = fade(u)
    local near, far = 0.15 + 1.5 * e, 0.4 + 2.1 * e
    local cs, sn = math_cos(m.seed), math_sin(m.seed)
    for i = 0, 7 do
        local dx, dy, dz = DIRS[i * 3 + 1], DIRS[i * 3 + 2] - 0.3, DIRS[i * 3 + 3]
        local rx, rz = dx * cs - dz * sn, dx * sn + dz * cs
        seg(x + rx * near, y + dy * near, z + rz * near, x + rx * far, y + dy * far, z + rz * far, 0.05, a, color)
    end
end

local function hitRing(m, age, color)
    local u = age / 0.45
    glowRing(m.x, m.y, m.z, 0.15 + outQuint(u) * 1.5, 0.05, fade(u), color)
end

local function hitCross(m, age, color)
    if line == nil then return end
    local x, y, z = m.x, m.y, m.z
    local u = age / 0.45
    local l = 0.25 + 0.75 * (1 - outCubic(u))
    local a = fade(u)
    seg(x - l, y, z, x + l, y, z, 0.05, a, color)
    seg(x, y - l, z, x, y + l, z, 0.05, a, color)
    seg(x, y, z - l, x, y, z + l, 0.05, a, color)
end

local HIT = { hitSpark, hitRing, hitCross }

function Fx.hit(x, y, z, now)
    if not Fx.canRing then return end
    take(2, HIT_MODES[cfg.hfx_mode] or 1, 0.46, x, y, z, now)
end

local function groundRing(m, age, color)
    local x, y, z = m.x, m.y + 0.06, m.z
    local s = m.scale
    local u = age / m.life
    local mode = m.mode
    if mode == 1 then
        glowRing(x, y, z, (0.55 + outQuint(u) * 2.9) * s, 0.05 + 0.09 * (1 - u), fade(u), color)
    elseif mode == 2 then
        glowRing(x, y, z, (0.55 + outQuint(u) * 2.9) * s, 0.05 + 0.08 * (1 - u), fade(u), color)
        local v = (age - 0.13) / (m.life - 0.13)
        if v > 0 and v < 1 then
            glowRing(x, y, z, (0.35 + outQuint(v) * 1.9) * s, 0.04 + 0.05 * (1 - v), fade(v) * 0.8, Theme.light)
        end
    else
        for k = 0, 2 do
            local v = (age - k * 0.11) / (m.life - 0.22)
            if v > 0 and v < 1 then
                thinRing(x, y, z, (0.4 + outQuint(v) * 3.3) * s, 0.06, fade(v) * (1 - k * 0.22), color)
            end
        end
    end
end

function Fx.circle(x, y, z, now, scale, life)
    if not Fx.canRing then return end
    local lift = cfg.fx_lift
    if type(lift) == "number" and lift ~= 0 then y = y + lift end
    local m = take(3, RING_STYLES[cfg.jump_style] or 1, life, x, y, z, now)
    m.scale = scale
end

local function velocityY() return movement.get_velocity().Y end

local function fireJump(now)
    local F = Fx
    local chained = F.jumpAt > 0 and now - F.jumpAt < 0.75
    F.jumped = true
    F.jumpAt = now
    if chained then
        F.chain = F.chain + 1
    else
        F.chain = 1
    end
    local x, y, z = Me.feet(now)
    if x == nil then return end
    if chained then
        F.circle(x, y, z, now, 1.18, 0.95)
    else
        F.circle(x, y, z, now, 1, 0.8)
    end
end

function Fx.tick(now)
    local F = Fx
    local g = State.grounded
    if now - F.lastTick > 0.25 then F.grounded = g end
    F.lastTick = now

    local vy
    if has(movement, "get_velocity") then
        local ok, v = pcall(velocityY)
        if ok and type(v) == "number" then vy = v end
    end

    if g ~= F.grounded then
        F.grounded = g
        if not g then
            F.airAt = now
            local fresh = F.groundAt == 0 or now - F.groundAt > 0.03
            if cfg.jump and State.alive and fresh and not F.jumped and (vy == nil or vy >= -4) then
                fireJump(now)
            end
        else
            F.groundAt = now
            F.jumped = false
            F.landAt = now
            if cfg.jump and cfg.jump_land and State.alive and now - F.airAt > 0.2 then
                local x, y, z = Me.feet(now)
                if x ~= nil then F.circle(x, y, z, now, 1.15, 0.7) end
            end
        end
    end
    if cfg.jump and State.alive and vy ~= nil then
        local lift = cfg.jump_vy
        if type(lift) ~= "number" or lift < 5 then lift = 20 end
        if vy > lift and (F.lastVY == nil or F.lastVY <= lift) and now - F.jumpAt > 0.12 and not F.jumped then
            fireJump(now)
        elseif vy < 0 then
            F.jumped = false
        end
        F.lastVY = vy
    end
    if cfg.steps and g and State.alive and State.speed > 6 and now >= F.stepAt then
        F.stepAt = now + 0.3
        local x, y, z = Me.feet(now)
        if x ~= nil then F.circle(x, y, z, now, 0.42, 0.5) end
    end
end

function Fx.render(now)
    local F = Fx
    if not F.canRing then return end
    if F.n > 0 then
        local n = 0
        local color = Theme.accent
        local pool = F.pool
        for i = 1, 12 do
            local m = pool[i]
            if m.on then
                local age = now - m.t0
                local kind = m.kind
                if age >= m.life or age < 0 or (kind == 1 and not cfg.kfx) or (kind == 2 and not cfg.hfx) then
                    m.on = false
                else
                    n = n + 1
                    if kind == 1 then
                        KILL[m.mode](m, age, color)
                    elseif kind == 2 then
                        HIT[m.mode](m, age, color)
                    else
                        groundRing(m, age, color)
                    end
                end
            end
        end
        F.n = n
    end
end
end

