local function onPaint(dt)
    local S = State
    if S.dead then return end
    local now = clock()
    if S.paintBusy and now - S.paintStart < 1 then return end
    S.paintBusy = true
    S.paintStart = now
    local ok, err = pcall(paintBody, dt, now)
    S.paintBusy = false
    if not ok then
        local stage = S.paintStage
        local disable = report(stage, err)
        if stage == "intro" then
            Intro.finish()
        elseif disable and stage ~= "anim" and stage ~= "menu" then
            Off[stage] = true
        end
    end
end

local function onShutdown()
    if State.dead then return end
    State.dead = true
    pcall(Resolver.releaseAll)
    pcall(AA.release)
    pcall(Rage.release)
    pcall(Sound.release)
    pcall(Screen.cleanup)
    pcall(Intro.cleanup)
    if HUD.gui ~= nil then pcall(function() HUD.gui:Destroy() end) end
    if r3d ~= nil and type(r3d.clear) == "function" then pcall(r3d.clear) end
    pcall(Menu.save)
    if Resolver.dirty then pcall(Resolver.saveStats) end
    pcall(Resolver.printStats)
end

pcall(function()
    local playerGui = LP:FindFirstChildOfClass("PlayerGui")
    if playerGui then
        local old = playerGui:FindFirstChild("PhobiaHUD")
        if old then old:Destroy() end
        old = playerGui:FindFirstChild("PhobiaIntro")
        if old then old:Destroy() end
    end
end)

applySettings()
Resolver.loadStats()
Me.handle()
pcall(autoCloud)
if not Cloud.enabled then
    log("cloud configs off: no http member", 245, 196, 92)
end
if not Chat.canSay then
    log("chat features off: no chat member", 245, 196, 92)
end

do
    local ok, err = pcall(HUD.build)
    if not ok then report("hud", err) end
end
Intro.start()

client.set_event_callback("paint", onPaint)
client.set_event_callback("aim_fire", onFire)
client.set_event_callback("aim_hit", onHit)
client.set_event_callback("aim_miss", onMiss)
client.set_event_callback("shutdown", onShutdown)
events.on_tick(onTick)

log("loaded, " .. VERSION)
do
    local missing = {}
    if not AA.ok then missing[#missing + 1] = "aa.override_*" end
    if not AA.canLag then missing[#missing + 1] = "aa.override_fake_lag" end
    if not Fx.canRing then missing[#missing + 1] = "render3d.ring" end
    if not has(sounds, "override_hitsound") then missing[#missing + 1] = "sounds" end
    if not has(database, "write") then missing[#missing + 1] = "database" end
    if not has(ui, "is_menu_open") then missing[#missing + 1] = "ui.is_menu_open" end
    if not Rage.canHc then missing[#missing + 1] = "rage.override_hitchance" end
    if not Rage.canMd then missing[#missing + 1] = "rage.override_min_damage" end
    if #missing > 0 then
        log("optional API not found: " .. table_concat(missing, ", "), 245, 196, 92)
    end
end
Menu.build()
Menu.load()
Menu.onChange = applySettings
Menu.sync(clock())
Menu.ready = true
end
