function Indicators.setLine(i, text, colorId)
    local I = Indicators
    local line = I.lines[i]
    if text == nil then
        if I.shown[i] then
            I.shown[i] = false
            line.Visible = false
        end
        return
    end
    if text ~= I.text[i] then
        I.text[i] = text
        line.Text = text
    end
    if colorId ~= I.color[i] then
        I.color[i] = colorId
        line.TextColor3 = I.palette[colorId]
    end
    if not I.shown[i] then
        I.shown[i] = true
        line.Visible = true
    end
end

function Indicators.render(now)
    local I = Indicators
    local root = I.root
    if root == nil then return end
    local want = cfg.ind == true and State.ready
    if want ~= I.on then
        I.on = want
        root.Visible = want
        I.next = 0
    end
    if not want then return end

    local x = I.x
    if x.dirty then
        x.dirty = false
        root.Position = UDim2.new(0.5, x.v, 0.5, 24)
    end
    local f = I.fillX
    if f.dirty then
        f.dirty = false
        I.fill.Position = UDim2.new(f.v, 0, 0, 0)
    end

    if now < I.next then return end
    I.next = now + 0.07

    local scoped = HUD.scoped
    if scoped ~= I.scoped then
        I.scoped = scoped
        Anim.to(I.x, scoped and 46 or 0, 0.25, 3, 0, now)
    end
    local inv = HUD.inv
    if inv ~= I.inv then
        I.inv = inv
        Anim.to(I.fillX, inv and 0.5 or 0, 0.18, 3, 0, now)
    end

    local n = 0
    if AA.owned then
        n = n + 1
        local text = "AA " .. MOVE_NAMES[AA.st]
        if AA.manual == 1 then
            text = "AA LEFT"
        elseif AA.manual == 2 then
            text = "AA RIGHT"
        end
        I.setLine(n, text, 1)
    end
    local charge = HUD.dt
    if charge > 0 then
        n = n + 1
        I.setLine(n, "DT", charge >= 14 and 1 or 3)
    end
    if AA.lagOwned and AA.lag > 0 then
        n = n + 1
        I.setLine(n, "FL " .. AA.lag, 0)
    end
    local keys = nil
    if Rage.peek then
        keys = "PEEK"
    elseif Rage.force ~= nil and Rage.md ~= nil then
        keys = "DMG " .. Rage.md
    end
    if AA.exploit == 1 then
        keys = keys and (keys .. "  SPAM") or "SPAM"
    elseif AA.exploit == 2 then
        keys = keys and (keys .. "  ROLL") or "ROLL"
    end
    if Rage.fb then keys = keys and (keys .. "  BAIM") or "BAIM" end
    if Rage.fs then keys = keys and (keys .. "  SAFE") or "SAFE" end
    if keys ~= nil then
        n = n + 1
        I.setLine(n, keys, 1)
    end
    if HUD.reload then
        n = n + 1
        I.setLine(n, "RELOAD", 2)
    end
    local ts = Resolver.target
    if ts ~= nil and ts.alive and Resolver.active then
        if cfg.res then
            local text, level = Resolver.describe(ts)
            n = n + 1
            I.setLine(n, text, level == 1 and 4 or (level == 2 and 2 or 0))
        end
        local flags = nil
        if ts.baim then flags = ts.lethal and "LETHAL" or "BAIM" end
        if ts.safe then flags = flags and (flags .. "  SAFE") or "SAFE" end
        if ts.fd then flags = flags and (flags .. "  FD") or "FD" end
        if flags ~= nil then
            n = n + 1
            I.setLine(n, flags, 2)
        end
    end
    for i = n + 1, IND_LINES do I.setLine(i, nil, 0) end
end

