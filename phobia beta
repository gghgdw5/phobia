local function headDelta(h, pos)
    local head = get_hitbox(h, "head")
    return head.Y - pos.Y
end
local function rigFoot(now)
    if now < Me.rigAt then
        if Me.rigN > 0 then return Me.rigY, median(Me.rigS) end
        return nil
    end
    Me.rigAt = now + 0.4
    local ch
    pcall(function() ch = Me.h.Character end)
    if ch == nil then return nil end
    local root
    pcall(function() root = ch:FindFirstChild("HumanoidRootPart") end)
    if root == nil then pcall(function() root = ch.HumanoidRootPart end) end
    if root == nil then return nil end
    local okR, rp = pcall(function() return root.Position end)
    if not okR or not isVec(rp) then return nil end
    local lowest
    local okD, parts = pcall(function() return ch:GetDescendants() end)
    if okD and type(parts) == "table" then
        for i = 1, #parts do
            local part = parts[i]
            local ok, pos = pcall(function() return part.Position end)
            if ok and isVec(pos) then
                local half = 0
                local okS, size = pcall(function() return part.Size end)
                if okS and isVec(size) and type(size.Y) == "number" then half = size.Y * 0.5 end
                local bottom = pos.Y - half
                if lowest == nil or bottom < lowest then lowest = bottom end
            end
        end
    end
    if lowest == nil then
        if Me.rigN > 0 then return Me.rigY, median(Me.rigS) end
        return nil
    end
    local off = rp.Y - lowest
    if off < -1 or off > 8 then
        if Me.rigN > 0 then return Me.rigY, median(Me.rigS) end
        return nil
    end
    local n = Me.rigN + 1
    if n > 6 then
        for i = 1, 5 do Me.rigS[i] = Me.rigS[i + 1] end
        n = 6
    end
    Me.rigS[n] = off
    Me.rigN = n
    Me.rigY = rp.Y
    return rp.Y, median(Me.rigS)
end

function Me.calibrate(now, pos)
    local rigY, rigOff = rigFoot(now)
    if rigY ~= nil and rigOff ~= nil then
        local drop = rigY - pos.Y
        if drop > -0.8 and drop < 0.8 then
            Me.foot = clamp(rigOff, 0, 6)
            Me.src = 1
            return
        end
        if math_abs(drop - rigOff) < 0.8 then
            Me.foot = 0
            Me.src = 2
            return
        end
    end
    if now < Me.footAt or get_hitbox == nil then return end
    Me.footAt = now + 2
    local ok, dy = pcall(headDelta, Me.h, pos)
    if ok and type(dy) == "number" then
        if dy > 3.6 and dy < 9 then
            Me.foot = 0
            Me.src = 3
        elseif dy > 0.3 then
            Me.foot = clamp(4.6 - dy, 0, 3.4)
            Me.src = 4
        end
    end
end

function Me.feet(now)
    local p = Me.position()
    if p ~= nil then
        Me.calibrate(now, p)
        return p.X, p.Y - Me.foot, p.Z
    end
    local c = cameraPosition()
    if isVec(c) then return c.X, c.Y - 4.6, c.Z end
    return nil
end

function Me.head(now)
    if get_hitbox ~= nil then
        local ok, p = pcall(get_hitbox, Me.h, "head")
        if ok and isVec(p) then return p.X, p.Y, p.Z end
    end
    local x, y, z = Me.feet(now)
    if x == nil then return nil end
    return x, y + 4.5, z
end
end

