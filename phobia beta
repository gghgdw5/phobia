function Net.okBody(res)
    if type(res) == "string" then return true, res end
    if type(res) == "table" then
        if res.Success == true or res.success == true then
            return true, res.Body or res.body
        end
        if res.success == false or res.Success == false then
            return false, tostring(res.status or res.StatusCode or res.message or "request failed")
        end
        if type(res.body) == "string" then return true, res.body end
    end
    return false, "bad response"
end

function Net.fetch(url, timeout)
    local ms = timeout or 8000
    local refused
    if Net.req ~= nil then
        local ok, res = pcall(Net.req, {Url = url, Method = "GET", Timeout = ms})
        if ok then
            local good, body = Net.okBody(res)
            if good then return true, body end
            if type(res) == "table" then refused = body end
        end
    end
    if refused == nil and Net.creq ~= nil then
        local ok, res = pcall(Net.creq, {Url = url, Method = "GET", Timeout = ms})
        if ok then
            local good, body = Net.okBody(res)
            if good then return true, body end
            if type(res) == "table" then refused = body end
        end
    end
    if refused == nil and Net.json ~= nil and type(Net.json.get) == "function" then
        local ok, res = pcall(Net.json.get, url, {timeout = ms})
        if ok then
            local good, body = Net.okBody(res)
            if good then return true, body end
            if type(res) == "table" then refused = body end
        end
    end
    if refused == nil and Net.get ~= nil then
        local ok, res = pcall(Net.get, url)
        if ok and type(res) == "string" then return true, res end
    end
    if refused == nil then
        local ok, body = pcall(function() return game:HttpGet(url) end)
        if ok and type(body) == "string" then return true, body end
    end
    return false, refused or "http unavailable"
end

function Net.post(url, body, timeout)
    local ms = timeout or 8000
    local head = {["Content-Type"] = "application/json"}
    if Net.req ~= nil then
        local ok, res = pcall(Net.req, {Url = url, Method = "POST", Body = body, Headers = head, Timeout = ms})
        if ok then
            local good, txt = Net.okBody(res)
            if good then return true, txt end
        end
    end
    if Net.creq ~= nil then
        local ok, res = pcall(Net.creq, {Url = url, Method = "POST", Body = body, Headers = head, Timeout = ms})
        if ok then
            local good, txt = Net.okBody(res)
            if good then return true, txt end
        end
    end
    if Net.json ~= nil and type(Net.json.post) == "function" then
        local ok, res = pcall(Net.json.post, url, body, {timeout = ms, headers = head})
        if ok then
            local good, txt = Net.okBody(res)
            if good then return true, txt end
        end
    end
    return false, "http unavailable"
end

function Net.encode(t)
    if Net.json ~= nil and type(Net.json.json_encode) == "function" then
        local ok, txt = pcall(Net.json.json_encode, t)
        if ok and type(txt) == "string" then return txt end
    end
    local parts = {}
    for k, v in pairs(t) do
        if type(v) == "boolean" or type(v) == "number" then
            parts[#parts + 1] = tostring(k) .. "=" .. tostring(v)
        end
    end
    return "?" .. table_concat(parts, "&")
end

function Net.decode(txt)
    if type(txt) ~= "string" or txt == "" then return nil end
    if Net.json ~= nil and type(Net.json.json_decode) == "function" then
        local ok, obj = pcall(Net.json.json_decode, txt)
        if ok then return obj end
        return nil
    end
    local out = {}
    for pair in txt:gmatch("[A-Za-z_][A-Za-z0-9_]*=[^&]*") do
        local k, v = pair:match("^([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
        if k ~= nil then
            if v == "true" then
                out[k] = true
            elseif v == "false" then
                out[k] = false
            elseif tonumber(v) ~= nil then
                out[k] = tonumber(v)
            end
        end
    end
    return out
end

function Cloud.url(txt)
    if type(txt) ~= "string" then return nil end
    local t = txt:match("^%s*(.-)%s*$")
    if t == "" or not t:find("^https?://") then return nil end
    return t
end

local function unwrap(obj)
    if type(obj) ~= "table" then return nil end
    if type(obj.settings) == "table" and (obj.kind == "phobia" or obj.name ~= nil or obj.version ~= nil) then
        return obj.settings
    end
    return obj
end

local function pushText(txt, quiet)
    local applied, skipped = Config.apply(unwrap(Net.decode(txt)), "cloud")
    if applied == nil or applied == 0 then return false, "nothing to apply", 0 end
    if not quiet then
        Cloud.last = applied .. " options"
        if Toast ~= nil and type(Toast.push) == "function" then
            Toast.push("cloud: " .. applied .. " options", 2.2)
        end
        if cfg.log_cloud then logLine("cloud", applied .. " options applied, " .. skipped .. " skipped") end
    end
    return true, applied, skipped
end

function Cloud.apply(txt, quiet)
    if type(txt) ~= "string" or txt == "" then return false, "empty" end
    return pushText(txt, quiet)
end

function Cloud.payload()
    return {kind = "phobia", name = cfg.name, version = cfg.version, saved = os.time(), settings = Config.save()}
end

function Cloud.save(url)
    local u = Cloud.url(url)
    if u == nil then return false, "bad url" end
    if not Cloud.enabled then return false, "http unavailable" end
    Cloud.busy = true
    local ok, res = Net.post(u, Net.encode(Cloud.payload()))
    Cloud.busy = false
    if ok then
        Cloud.saved = Cloud.saved + 1
        Cloud.last = "saved"
        Cloud.err = ""
        if cfg.log_cloud then logLine("cloud", "saved to " .. u) end
        return true
    end
    Cloud.err = tostring(res)
    if cfg.log_cloud then logLine("cloud", "save failed: " .. Cloud.err) end
    return false, Cloud.err
end

function Cloud.load(url, quiet)
    local u = Cloud.url(url)
    if u == nil then return false, "bad url" end
    if not Cloud.enabled then return false, "http unavailable" end
    Cloud.busy = true
    local ok, body = Net.fetch(u)
    Cloud.busy = false
    if not ok then
        Cloud.err = tostring(body)
        if not quiet and Toast ~= nil and type(Toast.push) == "function" then
            Toast.push("cloud: " .. Cloud.err, 2.6)
        end
        return false, Cloud.err
    end
    Cloud.fetched = Cloud.fetched + 1
    local good, a, b = pushText(body, quiet)
    if good then
        Cloud.err = ""
        if cfg.log_cloud then logLine("cloud", "loaded from " .. u) end
        return true, a, b
    end
    Cloud.err = tostring(a)
    return false, a
end

local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

local function b64Clean(txt)
    local out = {}
    for i = 1, #txt do
        local c = txt:sub(i, i)
        if B64:find(c, 1, true) then out[#out + 1] = c end
    end
    return table_concat(out)
end

local function b64Encode(txt)
    local out = {}
    for i = 1, #txt, 3 do
        local a, b, c = txt:byte(i, i + 2)
        b = b or 0
        c = c or 0
        local n = a * 65536 + b * 256 + c
        out[#out + 1] = B64:sub(math_floor(n / 262144) % 64 + 1, math_floor(n / 262144) % 64 + 1)
        out[#out + 1] = B64:sub(math_floor(n / 4096) % 64 + 1, math_floor(n / 4096) % 64 + 1)
        if #txt >= i + 1 then
            out[#out + 1] = B64:sub(math_floor(n / 64) % 64 + 1, math_floor(n / 64) % 64 + 1)
        else
            out[#out + 1] = "="
        end
        if #txt >= i + 2 then
            out[#out + 1] = B64:sub(n % 64 + 1, n % 64 + 1)
        else
            out[#out + 1] = "="
        end
    end
    return table_concat(out)
end

local function b64Decode(txt)
    local clean = b64Clean(txt)
    local out = {}
    for i = 1, #clean, 4 do
        local quad = clean:sub(i, i + 3)
        if #quad == 4 then
            local n = 0
            for j = 1, 4 do
                local v = B64:find(quad:sub(j, j), 1, true)
                if v == nil then return nil end
                n = n * 64 + (v - 1)
            end
            out[#out + 1] = string.char(math_floor(n / 65536) % 256)
            out[#out + 1] = string.char(math_floor(n / 256) % 256)
            out[#out + 1] = string.char(n % 256)
        end
    end
    local txt2 = table_concat(out)
    local _, pad = txt:gsub("=", "")
    return txt2:sub(1, #txt2 - pad)
end

function Cloud.shareCode()
    local data = Config.save()
    local parts = {}
    for k, v in pairs(data) do
        if type(v) == "boolean" then
            parts[#parts + 1] = k .. "=" .. (v and "1" or "0")
        elseif type(v) == "number" then
            parts[#parts + 1] = k .. "=" .. tostring(math_floor(v * 100 + 0.5) / 100)
        elseif type(v) == "string" and #v < 24 then
            parts[#parts + 1] = k .. "=" .. v
        end
    end
    table.sort(parts)
    return "PHB1-" .. b64Encode(table_concat(parts, "&"))
end

function Cloud.useShareCode(code)
    if type(code) ~= "string" then return false, "empty" end
    local body = code:match("^%s*PHB1%-(.-)%s*$")
    if body == nil then return false, "not a phobia code" end
    local raw = b64Decode(body)
    if raw == nil or raw == "" then return false, "corrupt code" end
    local data = {}
    for pair in raw:gmatch("[^&]+") do
        local k, v = pair:match("^([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
        if k ~= nil then
            if v == "1" then
                data[k] = true
            elseif v == "0" then
                data[k] = false
            elseif tonumber(v) ~= nil and not v:find("[%a]") then
                data[k] = tonumber(v)
            else
                data[k] = v
            end
        end
    end
    local applied, skipped = Config.apply(data, "code")
    if applied == nil or applied == 0 then return false, "nothing to apply" end
    if Toast ~= nil and type(Toast.push) == "function" then
        Toast.push("code: " .. applied .. " options", 2.2)
    end
    if cfg.log_cloud then logLine("cloud", "code applied: " .. applied .. " options, " .. skipped .. " skipped") end
    return true, applied, skipped
end

