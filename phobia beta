local function runAction(act, now)
    if act == "reset" then
        Menu.reset()
        announce("Settings reset to defaults", 1, now)
    elseif act == "res_reset" then
        Resolver.resetMemory()
        announce("Resolver memory cleared", 1, now)
    elseif act == "slot_save" then
