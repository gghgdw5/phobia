Def.stats = { mags = {}, nMag = 0, sides = 0, pitches = 0, swings = 0, chokes = 0, shifts = 0, plans = 0 }
Def.out = {}
Def.nOut = 0
Def.aim = 0

function Def.rnd(n)
    local D = Def
    local s = (D.seed * 1103515245 + 12345) % 2147483648
    D.seed = s
    local v = math_floor(s / 65536) % n
    return v
end

function Def.rollMag()
    local lo = cfg.def_min
    local hi = cfg.def_max
    if type(lo) ~= "number" then lo = 30 end
    if type(hi) ~= "number" then hi = 86 end
    lo = clamp(math_floor(lo), 10, 86)
    hi = clamp(math_floor(hi), lo + 4, 86)
    return lo + Def.rnd(hi - lo + 1)
end

local function noteMag(v)
    local st = Def.stats
    for i = 1, st.nMag do
        if st.mags[i] == v then return end
    end
    if st.nMag < 8 then
        st.nMag = st.nMag + 1
        st.mags[st.nMag] = v
    end
end

function Def.push(v)
    local D = Def
    local n = D.nOut % 24 + 1
    D.out[n] = v
    D.nOut = n
    D.outCount = (D.outCount or 0) + 1
end

function Def.flip(now)
    local D = Def
    local mode = cfg.def_mode
    if type(mode) ~= "string" then mode = "Deny" end
    D.mode = mode
    local lo, hi = 20, 86
    local rl, rh = cfg.def_min, cfg.def_max
    if type(rl) == "number" then lo = clamp(math_floor(rl), 6, 84) end
    if type(rh) == "number" then hi = clamp(math_floor(rh), lo + 2, 86) end
    if mode == "Ghost" then
        hi = math_min(hi, lo + 20)
    elseif mode == "Steady" then
        if D.steadyMag == nil then D.steadyMag = lo + D.rnd(hi - lo + 1) end
        lo, hi = D.steadyMag, D.steadyMag
    end
    local mag = lo + D.rnd(hi - lo + 1)
    noteMag(mag)
    local side = D.rnd(2) == 1
    if cfg.flick_vel then
        local ok, v = pcall(function() return movement.get_velocity() end)
        if ok and type(v) == "table" then
            local vx = tonumber(v.X)
            local vz = tonumber(v.Z)
            if vx ~= nil and vz ~= nil and math.sqrt(vx * vx + vz * vz) > 10 and vx < -10 then
                side = not side
            end
        end
    end
    D.side = side
    D.mag = mag
    D.magL = mag
    local r = mag + (D.rnd(13) - 6)
    if r > 86 then r = 86 elseif r < 8 then r = 8 end
    D.magR = r
    D.inv = side
    local off = 10 + D.rnd(31)
    D.off = side and off or -off
    if cfg.def_pitch ~= false and mode ~= "Steady" then
        if D.rnd(10) == 1 then
            D.pitch = 0
        else
            local p = 55 + D.rnd(24)
            D.pitch = (D.rnd(2) == 1) and p or -p
        end
        D.stats.pitches = D.stats.pitches + 1
    else
        D.pitch = 0
    end
    D.stats.plans = D.stats.plans + 1
    D.stats.flips = (D.stats.flips or 0) + 1
    if D.lastSide ~= nil and D.lastSide ~= side then D.stats.sideFlips = (D.stats.sideFlips or 0) + 1 end
    if side then D.stats.sideOn = (D.stats.sideOn or 0) + 1 end
    D.lastSide = side
    local sh = D.sideHist
    if sh == nil then
        sh = {}
        D.sideHist = sh
    end
    local sn = (D.sideN or 0) % 24 + 1
    D.sideN = sn
    sh[sn] = side
    Def.push(D.off)
    local rate = cfg.def_rate
    if type(rate) ~= "number" or rate < 20 then rate = 50 end
    if mode == "Ghost" then
        rate = rate * 1.8
    elseif mode == "Steady" then
        rate = math_max(rate, 160)
    end
    local gap = rate / 1000 * (0.6 + D.rnd(80) / 100)
    if (D.aim or 0) > 0.6 and mode == "Deny" then gap = 0.016 end
    D.planAt = now + math_max(0.016, gap)
end

function Def.plan(now)
    Def.flip(now)
end

function Def.swing(now)
    local D = Def
    D.side = not D.side
    D.mag = Def.rollMag()
    noteMag(D.mag)
    D.magL, D.magR = 86, 86
    D.inv = D.side
    D.off = D.side and 86 or -86
    D.big = D.off
    D.lastSide = D.side
    Def.push(D.off)
    D.pitchFlip = not D.pitchFlip
    D.pitch = D.pitchFlip and 89 or -89
    D.flicked = D.flicked + 1
    D.stats.swings = D.stats.swings + 1
    D.swingUntil = now + 0.06
    D.planAt = now + 0.06
    local shift = cfg.def_shift
    if type(shift) ~= "number" then shift = 8 end
    shift = clamp(math_floor(shift), 0, 14)
    if shift > 0 then
        if has(rage, "force_shift") then
            pcall(rage.force_shift, shift)
        elseif has(rage, "shift_ticks") then
            pcall(rage.shift_ticks, shift)
        end
        D.stats.shifts = D.stats.shifts + 1
    end
    if cfg.def_choke then
        if has(aa, "override_fake_lag_limit") then pcall(aa.override_fake_lag_limit, 4) end
        if has(aa, "unchoke") then pcall(aa.unchoke) end
