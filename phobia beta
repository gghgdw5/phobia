local function colorParts(c) return c.R, c.G, c.B end
local function toColor(a, b, c)
    if type(a) == "number" and type(b) == "number" and type(c) == "number" then
        if a <= 1 and b <= 1 and c <= 1 then return Color3.new(a, b, c) end
        return Color3.fromRGB(a, b, c)
    end
    if a ~= nil then
        local ok, r, g, bl = pcall(colorParts, a)
        if ok and type(r) == "number" and type(g) == "number" and type(bl) == "number" then return a end
    end
    return nil
end

local function readValue(it)
    local ok, a, b, c = pcall(hget, it.h)
    if not ok then return nil end
    local kind = it.kind
    if kind == "text" then
        if type(a) ~= "string" or a == "" then return nil end
        return a
    end
    if kind == "toggle" then
        return a == true
    elseif kind == "slider" then
        return tonumber(a)
    elseif kind == "combo" then
        local opts = it.opts
        if type(a) == "number" and opts[a] ~= nil then a = opts[a] end
        if type(a) ~= "string" then return nil end
        for i = 1, #opts do
            if opts[i] == a then return a end
        end
        return nil
    elseif kind == "color" then
        return toColor(a, b, c)
    end
    return nil
end

function Menu.sync(now)
    Menu.dirty = false
    Menu.nextPoll = now + 0.5
    local items = Menu.items
    local changed = false
    for i = 1, #items do
        local it = items[i]
        if it.val then
            local v = readValue(it)
            if v ~= nil then
                if it.kind == "color" then
                    local r, g, b = rgb(v)
                    local id = r * 65536 + g * 256 + b
                    if id ~= it.id then
                        it.id = id
                        cfg[it.key] = v
                        changed = true
                    end
                elseif v ~= cfg[it.key] then
                    cfg[it.key] = v
                    changed = true
                end
            end
        end
    end
    for i = 1, #items do
        local it = items[i]
        if it.parent ~= nil or it.cond ~= nil then
            local vis = (it.parent == nil or cfg[it.parent] == true) and (it.cond == nil or it.cond() == true)
            if vis ~= it.vis then
                it.vis = vis
                pcall(hvis, it.h, vis)
            end
        end
    end
    if changed then
        if Menu.ready then Menu.saveAt = now + 1 end
        if Menu.onChange then Menu.onChange() end
    end
end

local canKeyDown = has(input, "is_key_down")
local function keyHeld(name)
    if has(input, "is_typing") then
        local ok, typing = pcall(input.is_typing)
        if ok and typing == true then return false end
    end
    local ok, down = pcall(input.is_key_down, name)
    return ok and down == true
end

function Menu.pollKeys()
    local list = Menu.keys
    for i = 1, #list do
        local it = list[i]
        local on = false
        if it.vis then
            local ok, v = pcall(hget, it.h)
            if ok then
                local kind = type(v)
                if kind == "table" then
                    v = v.active or v.enabled or v.state or v[1]
                elseif kind == "string" and v ~= "" and canKeyDown then
                    v = keyHeld(v)
                end
                on = v == true
            end
            it.live = it.live + 1
        else
            it.live = 0
        end
        Bind[it.key] = on
    end
end

local POS_KEYS = { "wm_x", "wm_y", "kb_x", "kb_y", "st_x", "st_y", "th_x", "th_y" }

local function snapshot()
    local out = {}
    local items = Menu.items
    for i = 1, #items do
        local it = items[i]
        local kind = it.kind
        if kind == "toggle" or kind == "slider" or kind == "combo" or kind == "text" then
            out[it.key] = cfg[it.key]
        elseif kind == "color" then
            local r, g, b = rgb(cfg[it.key])
            out[it.key] = { r = r, g = g, b = b }
        end
    end
    local pos = Menu.pos
    for i = 1, #POS_KEYS do
        local k = POS_KEYS[i]
        out[k] = pos[k]
    end
    return out
end

function Menu.save()
    Menu.saveAt = nil
    dbWrite(DB_CONFIG, snapshot())
end

local function setValue(it, v)
    local kind = it.kind
    if kind == "toggle" then
        if type(v) == "boolean" then pcall(hset, it.h, v) end
    elseif kind == "slider" then
        if type(v) == "number" then pcall(hset, it.h, clamp(v, it.lo, it.hi)) end
    elseif kind == "combo" then
        if type(v) == "string" then
            for k = 1, #it.opts do
                if it.opts[k] == v then pcall(hset, it.h, v); break end
            end
        end
    elseif kind == "color" then
        if type(v) == "table" and type(v.r) == "number" and type(v.g) == "number" and type(v.b) == "number" then
            pcall(hset, it.h, Color3.fromRGB(clamp(v.r, 0, 255), clamp(v.g, 0, 255), clamp(v.b, 0, 255)))
        end
    elseif kind == "text" then
        if type(v) == "string" then pcall(hset, it.h, v) end
    end
end

local function restore(data, skip)
    local items = Menu.items
    for i = 1, #items do
        local it = items[i]
        local v = data[it.key]
        if v ~= nil and it.val and it.key ~= skip then setValue(it, v) end
    end
    local pos = Menu.pos
    for i = 1, #POS_KEYS do
        local k = POS_KEYS[i]
        if type(data[k]) == "number" then pos[k] = data[k] else pos[k] = nil end
    end
end

function Menu.load()
    local data = dbRead(DB_CONFIG)
    if type(data) == "table" then restore(data, nil) end
end

function Menu.slotSave()
    dbWrite(DB_CONFIG .. "." .. cfg.slot, snapshot())
    return cfg.slot
end

function Menu.slotLoad()
    local data = dbRead(DB_CONFIG .. "." .. cfg.slot)
    if type(data) ~= "table" then return nil end
    restore(data, "slot")
    Menu.dirty = true
    return cfg.slot
end

function Menu.reset()
    local items = Menu.items
    for i = 1, #items do
        local it = items[i]
        if it.val then pcall(hset, it.h, it.def) end
    end
    local pos = Menu.pos
    for i = 1, #POS_KEYS do pos[POS_KEYS[i]] = nil end
    Menu.dirty = true
end

function Config.save()
    return snapshot()
end

function Config.apply(data, skip)
    if type(data) ~= "table" then return nil end
    local keys = {}
    for k, v in pairs(data) do
        if cfg[k] ~= nil and Menu.byKey[k] ~= nil and type(v) ~= "table" and k ~= skip then
            keys[#keys + 1] = k
        end
    end
    restore(data, skip)
    local applied, skipped = 0, 0
    for i = 1, #keys do
        local it = Menu.byKey[keys[i]]
        if readValue(it) ~= nil then
            applied = applied + 1
        else
            skipped = skipped + 1
        end
    end
    if applied > 0 then Menu.dirty = true end
    return applied, skipped
end

