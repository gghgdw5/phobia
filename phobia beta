local function latencyMs()
    if has(client, "latency") then
        local ok, seconds = pcall(client.latency)
        if ok and type(seconds) == "number" and seconds >= 0 then return math_floor(seconds * 1000 + 0.5) end
    end
    return -1
end

local function barWidth() return Watermark.bar.AbsoluteSize.X end

function Watermark.refresh(now)
    local W = Watermark
    local st = W.stats

    local fps = 0
    if W.time > 0 then fps = math_floor(W.frames / W.time + 0.5) end
    W.frames = 0
    W.time = 0
    if fps ~= W.lastFps then
        W.lastFps = fps
        st.fps.value.Text = fps .. " fps"
        local rate = fps >= 55 and 1 or (fps >= 30 and 2 or 3)
        if rate ~= W.fpsRate then
            W.fpsRate = rate
            st.fps.dot.BackgroundColor3 = rate == 1 and C_GOOD or (rate == 2 and C_FAIR or C_BAD)
        end
    end

    local ping = latencyMs()
    if ping ~= W.lastPing then
        W.lastPing = ping
        if ping < 0 then
            st.ping.value.Text = "n/a"
        else
            st.ping.value.Text = ping .. " ms"
        end
        local rate = ping < 0 and 2 or (ping <= 90 and 1 or (ping <= 180 and 2 or 3))
        if rate ~= W.pingRate then
            W.pingRate = rate
            st.ping.dot.BackgroundColor3 = rate == 1 and C_GOOD or (rate == 2 and C_FAIR or C_BAD)
        end
    end

    local okW, width = pcall(barWidth)
    if okW and type(width) == "number" and width > 40 then W.w = width end
    if Drag.active ~= W then Drag.place(W, now) end
end

function Watermark.render(now, dt)
    local W = Watermark
    local bar = W.bar
    if bar == nil then return end
    local want = cfg.wm == true and State.ready
    if want ~= W.on then
        W.on = want
        if want then
            bar.Visible = true
            W.nextRefresh = 0
            Anim.set(W.slide, -10)
            Anim.to(W.slide, 0, 0.5, 3, 0, now)
            Anim.to(W.alpha, 1, 0.4, 2, 0, now)
        else
            Anim.to(W.alpha, 0, 0.2, 2, 0, now)
        end
    end
    local a = W.alpha
    if a.dirty then
        a.dirty = false
        fadeApply(W.fade, a.v)
        if not W.on and not a.on then bar.Visible = false end
    end
    if not W.on then return end

    W.frames = W.frames + 1
    W.time = W.time + dt
    if now >= W.nextRefresh then
        W.nextRefresh = now + 0.5
        W.refresh(now)
    end

    local s = W.slide
    if s.dirty or W.moved then
        s.dirty = false
        W.moved = false
        bar.Position = UDim2.new(0, W.px, 0, W.py + s.v)
    end
    if State.frame % 2 == 0 then W.edge.Rotation = (now * 50) % 360 end
end

