local function tryKey(sec, text, mode) return sec:new_keybind(text, mode) end
local function tryColor(sec, text, default) return sec:new_colorpicker(text, default, markDirty) end
local function tryLabel(sec, text) return sec:new_label(text) end
local function tryText(sec, text, ph, def) return sec:new_textbox(text, ph, def, markDirty) end
local function tryButton(sec, text, fn) return sec:new_button(text, fn) end

local function created(ok, handle)
