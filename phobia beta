            Anim.to(P.alpha, 0, 0.2, 2, 0, now)
        end
    end
    local a = P.alpha
    if a.dirty then
        a.dirty = false
        fadeApply(P.fade, a.v)
        if not P.on and not a.on then frame.Visible = false end
    end
    if not P.on then return end
    local h = P.height
    if h.dirty then
        h.dirty = false
        P.h = h.v
        frame.Size = UDim2.new(0, PANEL_W, 0, h.v)
    end
    if now >= P.placeAt then
        P.placeAt = now + 1
        if Drag.active ~= P then Drag.place(P, now) end
    end
    if P.moved then
        P.moved = false
        frame.Position = UDim2.new(0, P.px, 0, P.py)
    end
end

