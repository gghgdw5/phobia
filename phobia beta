function Panel.count(P, n, now)
    if n == P.n then return end
    for i = 1, P.rows do
        local vis = i <= n
        if vis ~= (i <= P.n) then
            P.left[i].Visible = vis
            P.right[i].Visible = vis
        end
    end
    P.n = n
    local target = PANEL_HEAD
    if n > 0 then target = PANEL_HEAD + 6 + n * PANEL_ROW + 6 end
    Anim.to(P.height, target, 0.22, 3, 0, now)
