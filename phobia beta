local function hitboxName(hitbox)
    if type(hitbox) == "string" and #hitbox > 0 then
        local text = string_gsub(hitbox, "_", " ")
        return string_lower(text)
    end
    if type(hitbox) == "number" then return "hitbox " .. hitbox end
    return "body"
end

local function pushLog(hit, name, hitbox, damage, hp, reason, resolverMiss, rec, now)
    local who = plain(name)
    local part = hitboxName(hitbox)
    local text, color, console
    if hit then
        local dmg = "?"
        if type(damage) == "number" then dmg = tostring(math_floor(damage + 0.5)) end
        text = "Hit " .. who .. " in " .. part .. " for " .. dmg
        console = "Hit " .. name .. " in the " .. part .. " for " .. dmg
        color = Theme.accent
        if type(hp) == "number" then
            if hp <= 0 then
                text = text .. " | dead"
                console = console .. " (dead)"
                color = C_GOOD
            else
                local left = math_floor(hp + 0.5)
                text = text .. " | " .. left .. " hp left"
                console = console .. " (" .. left .. " hp left)"
            end
        end
        if cfg.logs and State.ready then Logs.push(text, color, now) end
        if cfg.conlog then log(console, Theme.r, Theme.g, Theme.b) end
    else
        local why = "unknown"
        if reason ~= nil then why = string_lower(tostring(reason)) end
        if why == "?" then why = "resolver" end
        text = "Missed " .. who .. "'s " .. part .. " | " .. plain(why)
        console = "Missed " .. name .. "'s " .. part .. " due to " .. why
        if resolverMiss and rec ~= nil and rec.text ~= nil then
            text = text .. "  " .. rec.text
            console = console .. " [" .. rec.text .. "]"
        end
        if cfg.logs and State.ready and (not resolverMiss or cfg.res_log_miss == true) then
            Logs.push(text, resolverMiss and C_BAD or C_FAIR, now)
        end
        if cfg.conlog then log(console, 245, 104, 120) end
    end
end

local function fireBody(a, b, c, d)
    readEvent(a, b, c, d)
    local target, id, hitbox, point = EV.target, EV.id, EV.hitbox, EV.point
    local now = clock()
    local s = Resolver.fromTarget(target)
    if s == nil and Resolver.active then s = Resolver.target end
    if point ~= nil and not Me.isVec(point) then point = nil end
    local rec = Shots.fire(id, s, targetName(target, s, nil), hitbox, point, now)
    if rec ~= nil and cfg.dt_track and rec.s ~= nil and cfg.res and Resolver.active then
        Resolver.trackDT(rec, now)
    end
    Stats.shots = Stats.shots + 1
    Stats.dirty = true
end

local function resultBody(hit, a, b, c, d)
    readEvent(a, b, c, d)
    local target, id, hitbox, reason, damage, hpLeft = EV.target, EV.id, EV.hitbox, EV.reason, EV.damage, EV.hp
    local now = clock()
    local s = Resolver.fromTarget(target)
    local rec = Shots.take(id, s, now)
    if s == nil and rec ~= nil then s = rec.s end
    local name = targetName(target, s, rec)
    if hitbox == nil and rec ~= nil then hitbox = rec.hitbox end
    local head = isHead(hitbox)

    local resolverMiss, counted, spread = false, true, false
    if not hit then
        if reason == nil then
            resolverMiss = true
        else
            local r = string_lower(tostring(reason))
            resolverMiss = r == "resolver" or r == "?" or r == "unknown"
            counted = r ~= "death"
            spread = r == "spread"
        end
    end

    if rec ~= nil and rec.s ~= nil and cfg.res and Resolver.active then
        Resolver.result(rec, hit, head, resolverMiss, now)
    end

    if hit then
        Stats.hits = Stats.hits + 1
        if head then Stats.head = Stats.head + 1 end
        if type(damage) == "number" and damage > 0 then Stats.dealt = Stats.dealt + damage end
    elseif counted then
        Stats.miss = Stats.miss + 1
        if resolverMiss then Stats.rmiss = Stats.rmiss + 1 end
    end
    Stats.dirty = true

    if s ~= nil then
        if hit then
            s.spread = 0
            if s.hcBonus > 0 then s.hcBonus = s.hcBonus - 5 end
            if s.hcBonus < 0 then s.hcBonus = 0 end
        elseif spread then
            s.spread = s.spread + 1
            if s.spread >= 3 then
                s.spread = 0
                s.hcBonus = s.hcBonus + 10
                if s.hcBonus > 25 then s.hcBonus = 25 end
            end
        end
    end

    if hit then
        if cfg.lethal then Rage.learn(hitbox, damage, hpLeft) end
        local killed = type(hpLeft) == "number" and hpLeft <= 0
        if cfg.dmgnum then DmgNum.spawn(damage, head, killed, now) end
        if killed then
            Stats.kills = Stats.kills + 1
            if cfg.kfx then
                if s ~= nil and Me.isVec(s.pos) then
                    Fx.kill(s.pos.X, s.pos.Y - s.foot, s.pos.Z, now)
                elseif rec ~= nil and Me.isVec(rec.vpos) then
                    Fx.kill(rec.vpos.X, rec.vpos.Y - 3, rec.vpos.Z, now)
                elseif rec ~= nil and rec.point ~= nil then
                    Fx.kill(rec.point.X, rec.point.Y - (head and 4.6 or 3.4), rec.point.Z, now)
                end
            end
            if State.ready and cfg.island then Island.push("Killed " .. name, 2) end
            if cfg.kill_say and Chat.canSay and now - Chat.lastKill > 0.4 then
                Chat.lastKill = now
                Chat.say(Chat.fill(cfg.kill_text, name, hpLeft, Rage.wepName))
            end
        elseif cfg.hfx and rec ~= nil and rec.point ~= nil then
            Fx.hit(rec.point.X, rec.point.Y, rec.point.Z, now)
        end
    end
    if cfg.logs or cfg.conlog then pushLog(hit, name, hitbox, damage, hpLeft, reason, resolverMiss, rec, now) end
end

local function onFire(a, b, c, d)
    if State.dead then return end
    local ok, err = pcall(fireBody, a, b, c, d)
    if not ok then report("aim_fire", err) end
    if cfg.rf and not State.dead then
        local now = clock()
        if now - Def.rfLast > 0.02 then
            local step = cfg.rf_ms
            if type(step) ~= "number" or step < 20 then step = 90 end
            Def.rfAt = now + step / 1000
        end
    end
end

local function onHit(a, b, c, d)
    if State.dead then return end
    local ok, err = pcall(resultBody, true, a, b, c, d)
    if not ok then report("aim_hit", err) end
end

local function onMiss(a, b, c, d)
    if State.dead then return end
    local ok, err = pcall(resultBody, false, a, b, c, d)
    if not ok then report("aim_miss", err) end
end

local function updateLocal(now)
    local S = State
    local wasAlive, before = S.alive, S.hp
    Me.poll()
    if not Me.known then return end
    local hp = S.hp
    if wasAlive and before > 0 and hp < before - 0.5 then
        local lost = before - hp
        Stats.taken = Stats.taken + lost
        Stats.dirty = true
        pcall(Def.onHit, now)
        if cfg.hurtlog then
            local left = math_floor(hp + 0.5)
            local text = "Took " .. math_floor(lost + 0.5) .. " damage"
            if left > 0 then text = text .. " | " .. left .. " hp left" end
            if S.ready and cfg.logs then Logs.push(text, C_BAD, now) end
            if cfg.conlog then log(text, 245, 104, 120) end
        end
        if S.ready and cfg.island and S.alive and hp <= 25 and before > 25 then Island.push("Low health", 3) end
    end
    if wasAlive and not S.alive and S.ready and cfg.island then Island.push("You died", 4) end
end

local function tickBody(now)
    local S = State
    local tickN = nil
    if tickcount ~= nil then tickN = tickcount() end
    if type(tickN) ~= "number" then tickN = S.tickN + 1 end
    S.tickN = tickN

    if tickN % 8 == 0 then
        S.stage = "local"
        updateLocal(now)
    end
    if tickN % 4 == 0 and not Off.keys then
        S.stage = "keys"
        Menu.pollKeys()
    end
    if not Off.motion then
        if cfg.aa or cfg.fl or cfg.airhc or cfg.steps then
            S.stage = "motion"
            Rage.motion()
        elseif cfg.jump then
            S.stage = "motion"
            Rage.ground()
        end
    end
    if not Off.rage then
        S.stage = "rage"
        Rage.tick(now, tickN)
    end
    pcall(Resolver.syncEngine, not Off.resolver)
    local resolverOn = not Off.resolver
    if resolverOn and (cfg.res or cfg.lethal or cfg.baimhp or cfg.baimair or cfg.crouch or cfg.adapthc or cfg.thud) then
        S.stage = "resolver"
        Resolver.tick(now, tickN)
    elseif Resolver.active then
        S.stage = "resolver"
        Resolver.releaseAll()
    end
    if not Off.aa then
        S.stage = "aa"
        AA.tick(now, tickN)
    end
    if (cfg.jump or cfg.steps) and not Off.fx then
        S.stage = "fx"
        Fx.tick(now)
    end
    if Resolver.dirty and now >= Resolver.saveAt then
        S.stage = "stats"
        Resolver.saveAt = now + 30
        Resolver.saveStats()
    end
end

local function onTick()
    local S = State
    if S.dead then return end
    local now = clock()
    pcall(Def.scan, now)
    pcall(Def.step, now)
    if S.tickBusy and now - S.tickStart < 1 then return end
    S.tickBusy = true
    S.tickStart = now
    local ok, err = pcall(tickBody, now)
    S.tickBusy = false
    if not ok then
        local stage = S.stage
        if report(stage, err) then
            Off[stage] = true
            if stage == "resolver" then
                pcall(Resolver.releaseAll)
            elseif stage == "aa" then
                pcall(AA.release)
            elseif stage == "rage" then
                pcall(Rage.release)
            end
            log(tostring(stage) .. " disabled after repeated errors", 245, 104, 120)
        end
    end
end

