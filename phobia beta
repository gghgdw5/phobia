        elseif not Cloud.enabled then
            announce("HTTP is not available in this sandbox", 3, now)
        else
            local ok, n = Cloud.load(u)
            if ok then
                announce("Cloud config loaded: " .. tostring(n) .. " options", 2, now)
            else
                announce("Cloud load failed: " .. tostring(n), 4, now)
            end
        end
    elseif act == "cloud_save" then
        local u = Cloud.url(cfg.cloud_cfg)
        if u == nil then
            announce("Set a config URL first", 3, now)
        elseif not Cloud.enabled then
            announce("HTTP is not available in this sandbox", 3, now)
        else
            local ok, err = Cloud.save(u)
            if ok then
                announce("Config uploaded", 2, now)
            else
                announce("Cloud save failed: " .. tostring(err), 4, now)
            end
        end
    elseif act == "share_apply" then
