local function report(name, err)
    local now = clock()
    local f = Faults[name]
    if f == nil then f = { n = 0, t = now, shown = 0 }; Faults[name] = f end
    if now - f.t > 5 then f.t = now; f.n = 0 end
    f.n = f.n + 1
    if f.shown < 3 then
        f.shown = f.shown + 1
        local msg = "[" .. NAME .. "] " .. tostring(name) .. ": " .. tostring(err)
        if has(client, "error") then
            if not pcall(client.error, msg) then print(msg) end
        else
            print(msg)
        end
    end
    return f.n >= 8
end

