local function median(t)
    local n = #t
    if n == 0 then return nil end
    local copy = {}
    for i = 1, n do copy[i] = t[i] end
    table.sort(copy)
    if n % 2 == 1 then return copy[(n + 1) / 2] end
    return (copy[n / 2] + copy[n / 2 + 1]) * 0.5
end

