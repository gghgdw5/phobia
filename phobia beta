    local o = Drag.active
    if o ~= nil then
        if down and o.on then
            local sw, sh = HUD.size(now)
            local maxX, maxY = sw - o.w, sh - o.h
            if maxX < 0 then maxX = 0 end
            if maxY < 0 then maxY = 0 end
            local x = clamp(mx - o.gx, 0, maxX)
            local y = clamp(my - o.gy, 0, maxY)
            if x ~= o.px or y ~= o.py then
                o.px = x
                o.py = y
                o.moved = true
            end
        else
            Drag.active = nil
            local pos = Menu.pos
            pos[o.kx] = o.px
            pos[o.ky] = o.py
            Menu.saveAt = now + 0.5
        end
    elseif down and not Drag.wasDown then
        local list = Drag.list
        for i = 1, #list do
            local c = list[i]
            if c.on and c.px ~= nil then
                local x0, y0 = c.px, c.py
                if mx >= x0 and mx <= x0 + c.w then
                    local hit = my >= y0 and my <= y0 + c.h
                    if not hit and Pointer.mode == 2 then
                        local shifted = my + HUD.guiInset()
                        hit = shifted >= y0 and shifted <= y0 + c.h
                    end
                    if hit then
                        Drag.active = c
                        c.gx = mx - x0
                        c.gy = my - y0
                        break
                    end
                end
            end
        end
    end
    Drag.wasDown = down
end

