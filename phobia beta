function Def.scan(now)
    local D = Def
    if now < D.nextScan then return end
    D.nextScan = now + 0.02
    D.scanRuns = D.scanRuns + 1
    D.threat = nil
    if cfg.def_auto ~= true or not State.alive then
        D.active = false
        return
    end
    local my = Me.position()
    if my == nil or not isVec(my) then
        D.active = false
        return
    end
    local okList, list = pcall(entity.get_enemies)
    if not okList or type(list) ~= "table" then
        D.active = false
        return
    end
    local cone = cfg.def_cone
    if type(cone) ~= "number" or cone < 8 or cone > 90 then cone = 45 end
    local reach = cfg.def_range
    if type(reach) ~= "number" or reach < 20 then reach = 250 end
    local best, bestScore, bestAim = nil, nil, 0
    for i = 1, #list do
        local p = list[i]
        local ok, ep = pcall(entity.get_player_position, p)
        if ok and isVec(ep) then
            local dx, dz = my.X - ep.X, my.Z - ep.Z
            local flat = math.sqrt(dx * dx + dz * dz)
            if flat > 2 and flat < reach then
                local want = math_atan2(dx, dz) * 57.29577951308232
                local aimed = 0
                local okA, pitch, yaw = pcall(entity.get_player_angles_deg, p)
                if okA and type(yaw) == "number" then
                    local d = math_abs((want - yaw + 180) % 360 - 180)
                    if d < cone then aimed = (cone - d) / cone end
                    local okL, lby = pcall(entity.get_player_lby_deg, p)
                    if aimed == 0 and okL and type(lby) == "number" then
                        local dl = math_abs((want - lby + 180) % 360 - 180)
                        if dl < cone then aimed = (cone - dl) / cone * 0.8 end
                    end
                end
                local near = 1 - flat / reach
                if aimed > 0 or near > 0.55 then
                    local score = near + aimed * 1.5
                    if bestScore == nil or score > bestScore then
                        best, bestScore, bestAim = p, score, aimed
                    end
                end
            end
        end
    end
    D.threat = best
    D.aim = bestAim
    if best == nil then
        D.active = false
        return
    end
    if not D.active then
        D.active = true
        D.seed = defSeed()
        Def.plan(now)
        D.swingAt = now + 0.15
        D.dodges = D.dodges + 1
        D.dodgesReal = D.dodgesReal + 1
        if cfg.log_def then log("unhittable: threat locked, angle owned", 137, 201, 245) end
    end
end

function Def.step(now)
    local D = Def
    if not D.active then return end
    if now >= (D.planAt or 0) and now >= (D.swingUntil or 0) then Def.flip(now) end
    if now >= (D.swingAt or 0) then
        local mode = D.mode or "Deny"
        local gap = 0.25 + D.rnd(95) / 100
        if mode == "Ghost" then
            gap = gap * 2.2
        elseif mode == "Steady" then
            gap = 0.55 + D.rnd(40) / 100
        end
        D.swingAt = now + gap
        D.pending = true
    end
end

function Def.onHit(now)
    local D = Def
    D.hits = D.hits + 1
    D.flipWin = not D.flipWin
    D.flipUntil = now + 0.9
    if cfg.def_brute ~= true then return end
    if has(rage, "reset_resolver_state") then pcall(rage.reset_resolver_state) end
    if has(rage, "shift_ticks") then pcall(rage.shift_ticks, 4) end
    D.stats.shifts = D.stats.shifts + 1
    D.seed = defSeed()
    Def.plan(now)
    D.swingAt = now + 0.05
    if cfg.log_def then log("unhittable: hit taken, pattern reseeded", 137, 201, 245) end
end

