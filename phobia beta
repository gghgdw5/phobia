    if n > 0 and q[n][1] == text then return end
    if I.cur ~= nil and I.cur[1] == text and I.state == 1 then return end
    if n >= 4 then table_remove(q, 1) end
    q[#q + 1] = { text, kind or 1 }
end

function Island.render(now)
    local I = Island
    local root = I.root
    if root == nil then return end
    local state = I.state
    if state == 0 then
        local q = I.queue
        if #q > 0 and State.ready and cfg.island then
            local item = table_remove(q, 1)
            I.cur = item
            I.state = 1
            I.t0 = now
            local kind = item[2]
            local c = kind == 2 and C_GOOD or (kind == 3 and C_FAIR or (kind == 4 and C_BAD or Theme.accent))
            I.dot.BackgroundColor3 = c
            I.glow.Color = c
            I.text.Text = item[1]
            local w = clamp(measure(item[1], 13, FONT_MEDIUM) + 58, 150, 520)
            root.Visible = true
            I.top = HUD.guiInset() + 8
            Anim.set(I.aW, 0)
            Anim.set(I.aY, I.top - 10)
            Anim.set(I.aText, 0)
            Anim.set(I.aDot, 4)
            Anim.to(I.aW, w, 0.55, 3, 0, now)
            Anim.to(I.aY, I.top, 0.55, 3, 0, now)
            Anim.to(I.aText, 1, 0.35, 3, 0.14, now)
            Anim.to(I.aDot, 9, 0.45, 5, 0.1, now)
        elseif #q > 0 and not cfg.island then
            I.queue = {}
        end
    elseif state == 1 then
        local hold = #I.queue > 0 and 1.7 or 2.9
        if now - I.t0 >= hold then
            I.state = 2
            Anim.to(I.aText, 0, 0.2, 2, 0, now)
            Anim.to(I.aDot, 4, 0.22, 2, 0, now)
            Anim.to(I.aW, 0, 0.42, 9, 0.08, now)
            Anim.to(I.aY, I.top - 10, 0.42, 9, 0.08, now)
        end
    elseif not I.aW.on then
        I.state = 0
        I.cur = nil
        I.aW.dirty = false
        I.aY.dirty = false
        root.Size = UDim2.new(0, 0, 0, ISLAND_H)
        root.Visible = false
    end
    if I.state == 0 then return end

    local w, y = I.aW, I.aY
    if w.dirty or y.dirty then
        w.dirty = false
        y.dirty = false
        root.Size = UDim2.new(0, w.v, 0, ISLAND_H)
        root.Position = UDim2.new(0.5, 0, 0, y.v)
    end
    local t = I.aText
    if t.dirty then
        t.dirty = false
        I.text.TextTransparency = 1 - t.v
        I.text.Position = UDim2.new(0, 38 + (1 - t.v) * 8, 0, 0)
    end
    local d = I.aDot
    if d.dirty then
        d.dirty = false
        I.dot.Size = UDim2.new(0, d.v, 0, d.v)
    end
end

function Screen.build(gui)
    local S = Screen
    local root = new("Frame", {
        Name = "Vignette", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Visible = false, ZIndex = 1,
    }, gui)
    for k = 1, 4 do
        local horizontal = k <= 2
        local edge = new("Frame", {
            AnchorPoint = Vector2.new(k == 4 and 1 or 0, k == 2 and 1 or 0),
            Position = UDim2.new(k == 4 and 1 or 0, 0, k == 2 and 1 or 0, 0),
            Size = horizontal and UDim2.new(1, 0, 0.24, 0) or UDim2.new(0.16, 0, 1, 0),
            BackgroundColor3 = C_BAD, BackgroundTransparency = 1, BorderSizePixel = 0,
        }, root)
        new("UIGradient", {
            Rotation = k == 1 and 90 or (k == 2 and 270 or (k == 3 and 0 or 180)),
            Transparency = NumberSequence.new(0.35, 1),
        }, edge)
        S.edges[k] = edge
    end
    S.root = root
end

function Screen.render(now)
    local S = Screen
    local root = S.root
    if root == nil then return end
    local low = cfg.lowhp == true and State.ready and State.alive and Me.known and State.hp > 0 and State.hp <= 30
    if low ~= S.vigOn then
        S.vigOn = low
        if low then root.Visible = true end
        Anim.to(S.aVig, low and 1 or 0, low and 0.35 or 0.6, 2, 0, now)
    end
    local v = S.aVig
    if v.dirty or (S.vigOn and State.frame % 2 == 0) then
        v.dirty = false
        local k = v.v * (0.72 + 0.28 * math_sin(now * 4.2))
        local t = 1 - k
        local edges = S.edges
        for i = 1, 4 do edges[i].BackgroundTransparency = t end
        if not S.vigOn and not v.on then root.Visible = false end
    end
end

function Screen.cleanup()
end

function Intro.build()
    local T = Intro
    local _, sh = viewport()
    local scale = clamp(sh / 900, 0.6, 2.4)
    local F = math_floor(100 * scale + 0.5)
    if F < 40 then F = 40 end
    local first, rest = string_sub(NAME, 1, 1), string_sub(NAME, 2)
    local H = math_ceil(F * 1.26)
    T.fs = F

    local gui = new("ScreenGui", {
        Name = "PhobiaIntro", ResetOnSpawn = false, IgnoreGuiInset = true,
        DisplayOrder = 10000, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    if gui == nil then return end
    T.gui = gui
    mount(gui)

    T.dim = new("Frame", {
        Name = "Dim", Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(9, 9, 14),
        BackgroundTransparency = 1, BorderSizePixel = 0,
    }, gui)

    local mask = new("Frame", {
        Name = "Mask", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 40, 0, H), BackgroundTransparency = 1, ClipsDescendants = true,
    }, gui)
    T.lift = new("Frame", {
        Name = "Lift", Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
    }, mask)
    local word = new("Frame", {
        Name = "Word", Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0, 40, 1, 0),
        BackgroundTransparency = 1, ClipsDescendants = false,
    }, T.lift)
    local head = new("TextLabel", {
        Name = "First", Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(0, F, 1, 0),
        BackgroundTransparency = 1, Font = FONT_BLACK, TextSize = F,
        Text = first, TextColor3 = Theme.accent, TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
    }, word)
    local slot = new("Frame", {
        Name = "Slot", Position = UDim2.new(0, F, 0, 0), Size = UDim2.new(0, 0, 1, 0),
        BackgroundTransparency = 1, ClipsDescendants = true,
    }, word)
    local tail = new("TextLabel", {
        Name = "Rest", Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(0, F * 4, 1, 0),
        BackgroundTransparency = 1, Font = FONT_BLACK, TextSize = F,
        Text = rest, TextColor3 = C_TEXT, TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
    }, slot)

    if T.lift == nil or word == nil or slot == nil or head == nil or tail == nil then
        T.gui = nil
        pcall(function() gui:Destroy() end)
        return
    end

    local function advance(label, text, fallback)
        local w = nil
        local ok = pcall(function()
            label.Text = text
            w = label.TextBounds.X
        end)
        if ok and type(w) == "number" and w > 1 and w == w then return math_ceil(w + 1) end
        local m = nil
        ok = pcall(function() m = measure(text, F, FONT_BLACK) end)
        if ok and type(m) == "number" and m > 1 then return math_ceil(m + 1) end
        return fallback
    end
    local wP = advance(head, first, math_ceil(F * 0.62))
    local wR = advance(tail, rest, math_ceil(F * 0.62 * #rest))
    local W = wP + wR

    pcall(function()
        head.Size = UDim2.new(0, wP, 1, 0)
        slot.Position = UDim2.new(0, wP, 0, 0)
        slot.Size = UDim2.new(0, 0, 1, 0)
        tail.Size = UDim2.new(0, wR + 4, 1, 0)
        word.Size = UDim2.new(0, W + 4, 1, 0)
        mask.Size = UDim2.new(0, W + 8, 0, H)
    end)

    T.word = word
    T.slot = slot
    T.x0 = -wP / 2
    T.x1 = -W / 2
    T.slotW = wR
end

function Intro.cleanup()
    local T = Intro
    T.active = false
    if T.gui ~= nil then
        pcall(function() T.gui:Destroy() end)
        T.gui = nil
    end
end

function Intro.finish()
    Intro.cleanup()
    if not State.ready then
        State.ready = true
        if cfg.island and Island.root ~= nil then
            Island.push(NAME .. " " .. VERSION .. " loaded", 1)
        elseif type(notify) == "function" then
            pcall(notify, NAME, "Loaded, " .. VERSION, 3, false)
        end
    end
end

function Intro.start()
    local ok, err = pcall(Intro.build)
    if not ok then
        report("intro", err)
        Intro.finish()
        return
    end
    local T = Intro
    if T.gui == nil or T.slot == nil or T.word == nil then
        Intro.finish()
        return
    end
    Intro.active = true
    Intro.stage = 0
    Intro.t0 = clock() + 0.1
end

function Intro.render(now)
    local T = Intro
    local t = now - T.t0
    local stage = T.stage

    if stage == 0 then
        if t >= 0 then
            T.stage = 1
            Anim.to(T.aDim, 0.7, 0.45, 2, 0, now)
            Anim.to(T.aLift, 0, 0.7, 7, 0.05, now)
        end
    elseif stage == 1 then
        if t >= 0.95 then
            T.stage = 2
            Anim.to(T.aOpen, 1, 0.7, 8, 0, now)
        end
    elseif stage == 2 then
        if t >= 2.55 then
            T.stage = 3
            Anim.set(T.aOpen, 1)
            Anim.to(T.aLift, -1, 0.45, 9, 0, now)
            Anim.to(T.aDim, 0, 0.5, 2, 0.05, now)
        end
    elseif t >= 3.2 then
        Intro.finish()
        return
    end

    local a = T.aDim
    if a.dirty then
        a.dirty = false
        local dim = T.dim
        if dim ~= nil then pcall(function() dim.BackgroundTransparency = 1 - a.v end) end
    end
    a = T.aLift
    if a.dirty then
        a.dirty = false
        local lift = T.lift
        if lift ~= nil then pcall(function() lift.Position = UDim2.new(0, 0, a.v, 0) end) end
    end
    local open = T.aOpen.v
    if open < 0 then open = 0 elseif open > 1 then open = 1 end
    local x = T.x0 + (T.x1 - T.x0) * open
    if T.word ~= nil then
        pcall(function() T.word.Position = UDim2.new(0.5, math_floor(x + 0.5), 0, 0) end)
    end
    if T.slot ~= nil then
        pcall(function() T.slot.Size = UDim2.new(0, math_floor(T.slotW * open + 0.5), 1, 0) end)
    end
end

