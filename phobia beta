        if blockUntil ~= nil then block[i] = blockUntil end
    end
end

Resolver.aiCap = 32

function Resolver.aiWrap(a)
    a = (a + 180) % 360 - 180
    if a > 180 then a = a - 360 elseif a < -180 then a = a + 360 end
