function Arrows.render()
    local A = Arrows
    local root = A.root
    if root == nil then return end
    local want = cfg.arrows == true and State.ready and State.alive
    if want ~= A.on then
        A.on = want
        root.Visible = want
    end
    if not want then return end
    local left, right = 0, 0
    local manual = AA.manual
    if manual == 1 then
        left = 2
    elseif manual == 2 then
        right = 2
    elseif HUD.inv then
        left = 1
    else
        right = 1
