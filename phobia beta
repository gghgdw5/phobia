function Resolver.aaSig(s, dd, jitter, yaw, prev)
    local sb = math_floor(math_abs(dd) / 14)
    if sb > 6 then sb = 6 end
    local sg = dd >= 0 and 1 or 0
    local sj = jitter and 1 or 0
    local sk = s.jitConf and 1 or 0
    if prev ~= nil then
        local step = math_abs(wrap180(yaw - prev))
        if step >= 20 then sk = sk + 2 elseif step >= 8 then sk = sk + 1 end
    end
    return sb * 12 + sg * 6 + sj * 3 + sk
end

function Resolver.aiAt(ai, k)
    local cap = Resolver.aiCap
    local i = (ai.n - k) % cap + 1
    return ai.seq[i], ai.ctxs[i]
end

function Resolver.aiAbs(v)
    if v < 0 then return -v end
    return v
end

function Resolver.aiObserve(ai, off, ctx)
    if ai == nil then return end
    local pred, conf = ai.pred, ai.conf
    for i = 1, 4 do
        local p = pred[i]
        if p then
            local d = Resolver.aiAbs(Resolver.aiWrap(off - p))
            local c = conf[i] * 0.82
            if d <= 9 then c = c + 1 end
            if c > 3 then c = 3 elseif c < 0 then c = 0 end
            conf[i] = c
        end
        pred[i] = false
    end
    local cap = Resolver.aiCap
    local i = ai.n % cap + 1
    ai.seq[i] = off
    ai.ctxs[i] = ctx
    ai.n = i
    ai.head = ai.head + 1
end

function Resolver.aiPredict(ai, ctx)
    local pred = ai.pred
    pred[1], pred[2], pred[3], pred[4] = false, false, false, false
    local head = ai.head
    if head < 3 then return pred end
    local wrap = Resolver.aiWrap
    local abs = Resolver.aiAbs

    local maxP = 8
    if maxP > head - 1 then maxP = head - 1 end
    local bestP, bestErr = 0, 1e9
    for p = 1, maxP do
        local err, cnt = 0, 0
        for k = 1, 5 do
            if k + p <= head then
                err = err + abs(wrap(Resolver.aiAt(ai, k) - Resolver.aiAt(ai, k + p)))
                cnt = cnt + 1
            end
        end
        if cnt >= 2 then
            local e = err / cnt
            if e < bestErr - 0.5 then bestErr, bestP = e, p end
        end
    end
    ai.period, ai.err = bestP, bestErr
    if bestP > 0 and bestErr <= 7 then pred[1] = wrap(Resolver.aiAt(ai, bestP)) end

    if head >= 3 then
        local o1 = Resolver.aiAt(ai, 1)
        local d1 = wrap(o1 - Resolver.aiAt(ai, 2))
        local d2 = wrap(Resolver.aiAt(ai, 2) - Resolver.aiAt(ai, 3))
        if d1 * d2 > 0 then
            local a1 = abs(d1)
            if a1 >= 2 and a1 <= 40 then pred[2] = wrap(o1 + d1 * 0.85) end
        end
    end

    local bins = ai.bins
    for i = 0, 11 do bins[i] = 0 end
    local use = head
    if use > 16 then use = 16 end
    for k = 1, use do
        local v, c = Resolver.aiAt(ai, k)
        local b = clamp(math_floor((v + 90) / 15), 0, 11)
        bins[b] = bins[b] + (c == ctx and 1.6 or 1)
    end
    local bestB, bestW = nil, 0
    for i = 0, 11 do
        if bins[i] > bestW then bestW, bestB = bins[i], i end
    end
    if bestB ~= nil and bestW >= 1.9 then pred[3] = bestB * 15 + 7.5 - 90 end

    local steps, tot = 0, 0
    local span = head - 1
    if span > 6 then span = 6 end
    for k = 1, span do
        tot = tot + wrap(Resolver.aiAt(ai, k) - Resolver.aiAt(ai, k + 1))
        steps = steps + 1
    end
    if steps >= 3 then
        local mean = tot / steps
        if mean > 35 then mean = 35 elseif mean < -35 then mean = -35 end
        pred[4] = wrap(Resolver.aiAt(ai, 1) + mean)
    end
    return pred
end

function Resolver.aiSelf(kind, count)
    local ai = Resolver.aiNew()
    local ok, graded = 0, 0
    for i = 1, count do
        local truth
        if kind == 1 then
            truth = (i % 2 == 0) and 58 or -58
        elseif kind == 2 then
            truth = Resolver.aiWrap(i * 14 - 170)
        elseif kind == 3 then
            local seq = { -40, 12, 66, 30 }
            truth = seq[i % 4 + 1]
        else
            truth = 0
        end
        local pred = Resolver.aiPredict(ai, 1)
        local bestK, bestC = 0, 0.2
        for k = 1, 4 do
            if pred[k] and ai.conf[k] > bestC then bestK, bestC = k, ai.conf[k] end
        end
        if bestK > 0 then
            graded = graded + 1
            if Resolver.aiAbs(Resolver.aiWrap(pred[bestK] - truth)) <= 9 then ok = ok + 1 end
        end
        Resolver.aiObserve(ai, truth, 1)
    end
    return ok, graded
end

local Keys = { cache = {}, n = 0 }
local function readUserId(p) return p.UserId end
local function readName(p)
    if get_name ~= nil then
        local ok, n = pcall(get_name, p)
        if ok and type(n) == "string" then return n end
    end
    return p.Name
end

local function keyOf(p)
    if p == nil then return nil end
    local tp = type(p)
    if tp == "number" or tp == "string" then return p end
    local k = Keys.cache[p]
    if k ~= nil then return k end
    local ok, id = pcall(readUserId, p)
    if ok and type(id) == "number" and id > 0 then k = id else k = p end
    if Keys.n > 256 then
        Keys.cache = {}
        Keys.n = 0
    end
    Keys.cache[p] = k
    Keys.n = Keys.n + 1
    return k
end

