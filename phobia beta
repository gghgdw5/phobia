local function commandRouter(sender, text)
    Chat.msgs = Chat.msgs + 1
    if type(text) ~= "string" or not cfg.chat_cmd then return end
    local t = text:match("^%s*(.-)%s*$")
    local pre = (type(cfg.chat_prefix) == "string" and cfg.chat_prefix ~= "") and cfg.chat_prefix or "."
    if t:sub(1, #pre) ~= pre then return end
    local cmd, args = t:sub(#pre + 1):match("^([^%s]+)%s*(.*)$")
    if cmd == nil then return end
    cmd = cmd:lower()
    Chat.cmds = Chat.cmds + 1
    if cmd == "ping" then
        Chat.say("pong")
    elseif cmd == "stats" then
        local st = Chat.stats
        if type(st) == "table" then
            local done = st.hits + st.miss
            local rate = done > 0 and math_floor(st.hits / done * 100 + 0.5) or 0
            Chat.say(string_format("kills %d | hits %d | hit rate %d%%", st.kills, st.hits, rate))
        end
    elseif cmd == "aa" then
