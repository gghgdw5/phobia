function Resolver.aiGet(s)
    local a = s.ai
    if a ~= nil then return a end
    local mem = Resolver.aiMem
    if mem == nil then
        mem = {}
        Resolver.aiMem = mem
        Resolver.aiMemN = 0
    end
    local key = s.key
    a = mem[key]
    if a == nil then
        a = Resolver.aiNew()
        if Resolver.aiMemN >= 64 then
            Resolver.aiMem = {}
            Resolver.aiMemN = 0
            mem = Resolver.aiMem
        end
