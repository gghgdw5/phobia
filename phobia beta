local function logsLayout(now)
    local list = Logs.list
    for i = 1, #list do
        local t = list[i]
        local target = (i - 1) * (TOAST_H + TOAST_GAP)
        if t.slotY ~= target then
            t.slotY = target
            Anim.to(t.y, target, 0.28, 3, 0, now)
        end
    end
end

function Logs.dismiss(t, now)
    local list = Logs.list
    for i = 1, #list do
        if list[i] == t then
            table_remove(list, i)
            break
        end
    end
    t.state = 2
    t.slotY = nil
    Anim.to(t.alpha, 0, 0.25, 2, 0, now)
    Anim.to(t.y, t.y.v - 8, 0.25, 2, 0, now)
    logsLayout(now)
end

function Logs.push(text, color, now)
    local L = Logs
    if L.root == nil then return end
    local list = L.list
    if L.lastText == text and L.lastAt ~= nil and now - L.lastAt < 1.2 then return end
    L.lastText = text
    L.lastAt = now
    if #list >= TOAST_MAX then Logs.dismiss(list[1], now) end
    local t = nil
    for i = 1, TOAST_SLOTS do
        if L.pool[i].state == 0 then
            t = L.pool[i]
            break
        end
    end
    if t == nil then
        for i = 1, TOAST_SLOTS do
            if L.pool[i].state == 2 then
                t = L.pool[i]
                break
            end
        end
    end
    if t == nil then return end
    t.state = 1
    t.born = now
    if #text > TOAST_CHARS then text = string_sub(text, 1, TOAST_CHARS - 3) .. "..." end
    t.label.Text = text
    t.label.TextColor3 = color
    t.dot.BackgroundColor3 = color
    t.frame.Visible = true
    list[#list + 1] = t
    local target = (#list - 1) * (TOAST_H + TOAST_GAP)
    t.slotY = target
    Anim.set(t.y, target + 12)
    Anim.to(t.y, target, 0.32, 3, 0, now)
    Anim.set(t.alpha, 0)
    Anim.to(t.alpha, 1, 0.22, 2, 0, now)
    L.busy = L.busy + 1
end

function Logs.render(now)
    local L = Logs
    if L.busy <= 0 then return end
    local busy = 0
    local pool = L.pool
    for i = 1, TOAST_SLOTS do
        local t = pool[i]
        local state = t.state
        if state ~= 0 then
            busy = busy + 1
            if state == 1 and now - t.born >= TOAST_LIFE then
                Logs.dismiss(t, now)
                state = 2
            end
            local a = t.alpha
            if a.dirty then
                a.dirty = false
                local v = a.v
                t.frame.BackgroundTransparency = 1 - 0.9 * v
                t.stroke.Transparency = 1 - 0.8 * v
                t.dot.BackgroundTransparency = 1 - v
                t.label.TextTransparency = 1 - v
                if state == 2 and not a.on then
                    t.state = 0
                    t.frame.Visible = false
                    busy = busy - 1
                end
            end
            local y = t.y
            if y.dirty then
                y.dirty = false
                t.frame.Position = UDim2.new(0.5, 0, 0, y.v)
            end
        end
    end
    L.busy = busy
end

function Logs.clear()
    local L = Logs
    for i = 1, TOAST_SLOTS do
        local t = L.pool[i]
        if t ~= nil and t.state ~= 0 then
            t.state = 0
            t.frame.Visible = false
        end
    end
    L.list = {}
    L.busy = 0
end

