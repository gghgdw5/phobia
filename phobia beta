        if v ~= state[side] then
            state[side] = v
            local color = v == 0 and WHITE or (v == 1 and Theme.accent or Theme.light)
            local alpha = v == 0 and 0.78 or 0
            local bars = A.bars[side]
            for k = 1, 2 do
                bars[k].BackgroundColor3 = color
                bars[k].BackgroundTransparency = alpha
            end
        end
    end
