local function hget(h) return h:get() end
local function hset(h, v) h:set(v, true) end
local function hvis(h, v) h:set_visible(v) end
local function markDirty() Menu.dirty = true end

local function stubHandle(default)
    local value = default
    local h = {}
    function h.get() return value end
    function h.set(_, v) value = v end
    function h.set_visible() end
    return h
end

local function register(key, kind, handle, default, parent, cond)
    if handle == nil then handle = stubHandle(default) end
    local it = { key = key, kind = kind, h = handle, def = default, parent = parent, cond = cond, vis = true, val = false, live = 0 }
    Menu.items[#Menu.items + 1] = it
    Menu.byKey[key] = it
    if kind == "key" then
        Menu.keys[#Menu.keys + 1] = it
        Bind[key] = false
    elseif kind ~= "label" and kind ~= "button" then
        it.val = true
        cfg[key] = default
    end
    return it
end

local function tryToggle(sec, text, default) return sec:new_toggle(text, default, markDirty) end
local function trySlider(sec, text, lo, hi, default, suffix) return sec:new_slider(text, lo, hi, default, 0, suffix, markDirty) end
