function Chat.say(msg, teamOnly)
    if type(msg) ~= "string" or msg == "" then return false end
    if not Chat.canSay or Chat.sending > 3 then return false end
    Chat.sending = Chat.sending + 1
    local ok, err = false, "no chat member"
    if Say.say ~= nil then
        ok, err = pcall(Say.say, msg)
    elseif Say.chat ~= nil then
        ok, err = pcall(Say.chat, msg, teamOnly == true)
    elseif Say.api ~= nil and type(Say.api.send) == "function" then
        ok, err = pcall(Say.api.send, msg)
    elseif Say.tcs ~= nil then
        ok, err = pcall(Say.tcs.SendAsync, Say.tcs, msg)
    end
    Chat.sending = Chat.sending - 1
    if ok then
        Chat.sent = Chat.sent + 1
        Chat.lastErr = ""
        if cfg.log_chat then logLine("chat", msg) end
    else
        Chat.lastErr = tostring(err)
    end
    return ok
end

