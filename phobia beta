local function localMoveState()
    if not State.grounded then return 5 end
    if State.duck then return 4 end
    local speed = State.speed
    if speed <= 0.4 then return 1 end
    if speed <= 6 then return 3 end
    return 2
end

local function manualSide(A)
    if not cfg.aa_manual then
        A.mready = false
        A.manual = 0
        return 0
    end
    local byKey = Menu.byKey
    if byKey.aa_left.live == 0 or byKey.aa_right.live == 0 then return A.manual end
    local l, r = Bind.aa_left == true, Bind.aa_right == true
    if A.mready then
        if l ~= A.kl then A.manual = A.manual == 1 and 0 or 1 end
        if r ~= A.kr then A.manual = A.manual == 2 and 0 or 2 end
    else
        A.mready = true
    end
    A.kl = l
    A.kr = r
    return A.manual
end

local function jitter(A, mode, r, tickN)
    if mode == "Spin" then return wrap180(tickN * 12) end
    if mode == "Off" or r <= 0 then return 0 end
    if mode == "Center" then
        return A.pkt % 2 == 0 and r or -r
    elseif mode == "Offset" then
        return A.pkt % 2 == 0 and r or 0
    elseif mode == "3-Way" then
        return (tickN % 3 - 1) * r
    elseif mode == "5-Way" then
        return (tickN % 5 - 2) * r * 0.5
    elseif mode == "Skitter" then
        local last = A.skit
        local first = math_random(1, 2) == 1
        local v
        if last == -1 then
            v = first and 0 or 1
        elseif last == 0 then
            v = first and -1 or 1
        else
            v = first and -1 or 0
        end
        A.skit = v
        return v * r
    elseif mode == "Sway" then
        return math_sin(tickN * 0.3) * r
    elseif mode == "Random" then
        return (math_random() * 2 - 1) * r
    elseif mode == "Sawtooth" then
        return -r + 2 * r * (tickN % 12) / 11
    elseif mode == "Burst" then
        return math_floor(tickN / 8) % 2 == 0 and r or -r
    elseif mode == "Zigzag" then
        local k = tickN % 4
        if k == 0 then return -r end
        if k == 1 then return r / 3 end
        if k == 2 then return -r / 3 end
        return r
    elseif mode == "Noise" then
        local v = A.walk + (math_random() * 2 - 1) * r * 0.5
        if v > r then v = r elseif v < -r then v = -r end
        A.walk = v
        return v
    elseif mode == "Step-hold" then
        if tickN >= A.stepUntil or tickN < A.stepUntil - 16 then
            A.stepVal = (math_random() * 2 - 1) * r
            A.stepUntil = tickN + math_random(2, 8)
        end
        return A.stepVal
    end
    return 0
end

local function safeMag()
    if math_random(1, 8) == 1 then return 72 end
    return math_random(14, 44)
end

local function lagValue(A, choking)
    local hi = cfg.fl_limit
    local lo = math_floor(hi / 3)
    if lo < 1 then lo = 1 end
    local m = cfg.fl_mode
    if m == "Static" then
        return hi, 0
    elseif m == "Random" then
        return math_random(lo, hi), 30
    elseif m == "Fluctuate" then
        if A.flPrev and not choking then A.flFlip = not A.flFlip end
        A.flPrev = choking
        return A.flFlip and hi or lo, 20
    end
    return State.speed > 5 and hi or lo, 25
end

local function setLag(A, lag, var)
    local C = AAC
    local on = lag > 0
    if C.flOn ~= on then
        C.flOn = on
        aa.override_fake_lag(on)
    end
    if C.flLim ~= lag then
        C.flLim = lag
        aa.override_fake_lag_limit(lag)
    end
    if A.canVar then
        if C.flVar ~= var then
            C.flVar = var
            aa.override_fake_lag_variability(var)
        end
    else
        C.flVar = nil
    end
    A.lag = lag
    A.lagOwned = true
end

local function lateralVel()
    local ok, v = pcall(movement.get_velocity)
    if not ok or type(v) ~= "table" then return 0, 0 end
    local x, z = tonumber(v.X), tonumber(v.Z)
    if x == nil or z == nil then return 0, 0 end
    return math.sqrt(x * x + z * z), x
end

local function scheduleFlick(A, tickN)
    A.nextFlick = tickN + math_random(14, 28)
end

function AA.tick(now, tickN)
    local A = AA
    local on = cfg.aa == true and A.ok
    local lagOn = cfg.fl == true and A.canLag

    if (A.owned and not on) or (A.lagOwned and not lagOn and A.exploit == 0) then
        A.owned = false
        A.lagOwned = false
        aaReset()
    end
    if not on then
        A.mready = false
        A.manual = 0
        A.exploit = 0
        if not lagOn then return end
    end

    local choking = false
    if A.canChoke then choking = aa.is_fake_lag_choking() == true end
    local sent = not choking
    if sent then A.pkt = A.pkt + 1 end
    local target = hasTarget()

    local lag = 0
    if lagOn then
        local var
        lag, var = lagValue(A, choking)
        if cfg.fl_cut and lag > 2 and target then lag = 2 end
        setLag(A, lag, var)
    end
    if Def.active and cfg.def_antichoke ~= false then
        if lagOn then setLag(A, 0, 0) end
        if has(aa, "override_fake_lag_limit") then
            if A.defLim ~= 1 then
                A.defLim = 1
                pcall(aa.override_fake_lag_limit, 1)
            end
        end
        if has(aa, "unchoke") then
            if A.defUnchoke == nil or now - A.defUnchoke > 0.03 then
                A.defUnchoke = now
                pcall(aa.unchoke)
                Def.stats.flushes = (Def.stats.flushes or 0) + 1
            end
        end
    elseif A.defLim ~= nil then
        A.defLim = nil
    end
    if not on then return end

    if not A.owned then
        A.owned = true
        A.since = tickN
        A.checked = false
        A.nextFlick = 0
        A.hp = State.hp
        A.reroll = true
    end

    local raw = localMoveState()
    if raw == A.cand then
        A.candN = A.candN + 1
    else
        A.cand = raw
        A.candN = 1
    end
    if A.candN >= 3 then A.st = raw end
    local st = A.st
    local peeked = st ~= A.prevSt and st ~= 1
    A.prevSt = st

    local hp = State.hp
    if A.hp ~= nil and hp > 0 and hp < A.hp - 0.5 then
        A.variant = A.variant % 4 + 1
        if cfg.aa_brute then
            A.panicUntil = tickN + 48
            A.panicMode = math_random(1, #PANIC_MODES)
            A.side = not A.side
            A.reroll = true
            A.hitFlick = true
        end
    end
    A.hp = hp
    local panic = cfg.aa_brute and tickN < A.panicUntil and tickN >= A.panicUntil - 48

    local mode, range = cfg.aa_yaw, cfg.aa_range
    if mode == "Adaptive" then
        mode = ADAPT_MODE[A.variant][st]
        range = ADAPT_RANGE[A.variant][st]
    end
    if panic then
        mode = PANIC_MODES[A.panicMode]
        if range < 30 then range = 30 end
    end
    local jv = jitter(A, mode, range, tickN)
    local manual = manualSide(A)
    if manual ~= 0 then
        local left = cfg.aa_swap and 90 or -90
        jv = manual == 1 and left or -left
    end

    local pitch = cfg.aa_pitch
    if pitch == "Jitter" then
        pitch = tickN % 2 == 0 and 89 or -89
    elseif pitch == "Random" then
        pitch = math_random(-89, 89)
    elseif pitch == "Sweep" then
        pitch = -89 + (tickN * 6) % 179
        if pitch > 89 then pitch = 89 end
    end

    local body = cfg.aa_body
    local limL, limR = 60, 60
    if panic then
        A.side = math_random(0, 1) == 1
        limL, limR = safeMag(), safeMag()
    elseif body == "Static" then
        A.side = Bind.aa_invert == true
        limL, limR = 58, 58
    elseif body == "Opposite" then
        if jv > 0 then A.side = true elseif jv < 0 then A.side = false end
    elseif body == "Jitter" then
        if sent then A.side = not A.side end
    elseif body == "Random" then
        if sent or A.reroll then
            A.side = math_random(0, 1) == 1
            A.magL = math_random(20, 86)
            A.magR = math_random(20, 86)
        end
        limL, limR = A.magL, A.magR
    elseif body == "Poison" then
        if sent or A.reroll then
            A.poison = not A.poison
            A.side = math_random(0, 1) == 1
            A.magL = A.poison and math_random(70, 86) or math_random(0, 8)
        end
        limL, limR = A.magL, A.magL
    else
        if sent or A.reroll then
            A.magL = safeMag()
            A.magR = safeMag()
            if math_random() < 0.7 then A.side = not A.side end
        end
        limL, limR = A.magL, A.magR
    end
    A.reroll = false
    local inv = A.side
    if Def.flipUntil > now then inv = not inv end

    local flick = A.hitFlick
    A.hitFlick = false
    local busy = Rage.peek == true or target
    if cfg.aa_def and not busy then
        local trigger = cfg.aa_def_mode
        if peeked and trigger ~= "Timer" then
            flick = true
        elseif trigger ~= "On peek" then
            if A.nextFlick == 0 then scheduleFlick(A, tickN) end
            if tickN >= A.nextFlick then
                if lag == 0 or not A.canCount then
                    flick = true
                else
                    local last = aa.get_choke_target() - 1
                    if last < 0 then last = 0 end
                    flick = aa.get_choked_ticks() >= last or tickN - A.nextFlick > 12
                end
            end
        end
    end
    if busy then flick = false end
    if flick then
        A.lastFlick = tickN
        A.flicks = A.flicks + 1
        scheduleFlick(A, tickN)
        A.pitchFlip = not A.pitchFlip
        pitch = A.pitchFlip and 89 or -89
        inv = not inv
        local side = inv and -1 or 1
        if cfg.flick_vel and A.canVel then
            local spd, vx = lateralVel()
            if spd > 10 and vx < -10 then side = -side end
        else
            side = math_random(0, 1) == 1 and 1 or -1
        end
        jv = 110 * side
    end

    setBodyYaw(true)
    setLimits(limL, limR)
    setYaw(180, "camera")
    setInverter(inv)
    setModifier("Disabled")
    setOffset(wrap180(jv))
    setPitch(pitch)

    if flick then
        if cfg.tb and A.canDT and A.canShift and rage.is_double_tap_charged() then rage.shift_ticks() end
        if A.canUnchoke then aa.unchoke() end
    end

    if Def.active then
        A.exploit = 2
        if cfg.def_asym ~= false and has(aa, "override_desync") then
            if not pcall(aa.override_desync, Def.magL, -Def.magR) then setLimits(Def.magL, Def.magR) end
            Def.stats.asym = (Def.stats.asym or 0) + 1
        else
            setLimits(Def.magL, Def.magR)
        end
        setInverter(Def.inv)
        setOffset(wrap180(Def.off))
        setPitch(Def.pitch)
        if Def.pending then
            Def.pending = false
            Def.swing(now)
        end
        A.rollT = A.rollT + 1
    elseif cfg.spam and Bind.spam_key then
        A.exploit = 1
        local m = cfg.spam_mode
        if m == "Random" then
            A.spamSide = math_random(0, 1) == 1
            setLimits(math_random(20, 86), math_random(20, 86))
        else
            A.spamSide = not A.spamSide
            setLimits(86, 86)
        end
        setInverter(A.spamSide)
        if m == "Max swing" then
            local swing = range < 30 and 30 or range
            setOffset(wrap180(A.spamSide and swing or -swing))
        end
        if A.canLag then setLag(A, 0, 0) end
    elseif cfg.roll and Bind.roll_key then
        A.exploit = 2
        A.rollT = A.rollT + 1
        A.rollSide = not A.rollSide
        local t = A.rollT
        local m = cfg.roll_mode
        local yawV, pitchV
        if m == "Roll spin" then
            yawV = t * 45
            pitchV = math_sin(t * 0.39269908169872414) * 89
        elseif m == "Pitch roll" then
            yawV = A.rollSide and 40 or -40
            pitchV = (t * 15) % 178 - 89
        else
            yawV = t * 76.5
            pitchV = t % 2 == 0 and 89 or -89
        end
        setLimits(86, 86)
        setInverter(A.rollSide)
        setOffset(wrap180(yawV))
        setPitch(clamp(pitchV, -89, 89))
        if A.canLag then setLag(A, 0, 0) end
    else
        A.exploit = 0
    end

    if not A.checked and tickN - A.since >= 64 then
        A.checked = true
        if has(aa, "get_yaw") then
            local ok, v = pcall(aa.get_yaw)
            if ok and type(v) == "number" and v ~= 180 then
                log("anti-aim: the engine reports yaw override " .. tostring(v) .. " instead of 180", 245, 196, 92)
            end
        end
    end
end

function Sound.apply()
    local S = Sound
    if has(sounds, "override_hitsound") then
        if cfg.sound then
            if not S.on or S.name ~= cfg.sound_name then
                S.on = true
                S.name = cfg.sound_name
                pcall(sounds.override_hitsound, cfg.sound_name, 1, 1)
            end
        elseif S.on then
            S.on = false
            S.name = nil
            if has(sounds, "reset_hitsound") then
                pcall(sounds.reset_hitsound)
            else
                pcall(sounds.override_hitsound, nil)
            end
        end
    end
    if has(sounds, "override_killsound") then
        if cfg.ksound then
            if not S.kon or S.kname ~= cfg.ksound_name then
                S.kon = true
                S.kname = cfg.ksound_name
                pcall(sounds.override_killsound, cfg.ksound_name, 1, 1)
            end
        elseif S.kon then
            S.kon = false
            S.kname = nil
            if has(sounds, "reset_killsound") then
                pcall(sounds.reset_killsound)
            else
                pcall(sounds.override_killsound, nil)
            end
        end
    end
end

function Sound.release()
    local S = Sound
    if S.on then
        S.on = false
        if has(sounds, "reset_hitsound") then pcall(sounds.reset_hitsound) else pcall(sounds.override_hitsound, nil) end
    end
    if S.kon then
        S.kon = false
        if has(sounds, "reset_killsound") then pcall(sounds.reset_killsound) else pcall(sounds.override_killsound, nil) end
    end
end

