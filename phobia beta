local function resetHistory(s)
    s.hn = 0
    s.hi = 0
    s.sumC = 0
    s.sumS = 0
    local c, sum = s.pbc, s.pbs
    c[1] = 0; c[2] = 0; c[3] = 0
    sum[1] = 0; sum[2] = 0; sum[3] = 0
    s.prevYaw = nil
    s.lastSign = 0
    s.f1 = -1000; s.f2 = -1000; s.f3 = -1000
end

local function newLife(s)
    resetHistory(s)
    s.misses = 0
    s.baimUntil = 0
    s.fdUntil = 0
    s.duckN = 0
    s.hyp = 0
    s.dtLock = nil
    local cm, bs = s.ctxMiss, s.bruteStage
    for c = 1, 4 do
        cm[c] = 0
        bs[c] = 0
    end
end

local function snapshot(s, p)
    local baim, safe = "-", "-"
    if plist_get ~= nil then
        local ok, v = pcall(plist_get, p, K_BAIM)
        if ok and v ~= nil and v ~= false then baim = v end
        ok, v = pcall(plist_get, p, K_SAFE)
        if ok and v ~= nil and v ~= false then safe = v end
    end
    s.saved = { baim, safe }
    s.aBaim = baim
    s.aSafe = safe
end

local function applyOverrides(s, p, force, ang, pf, pv, baim, safe, now, isTarget)
    if s.saved == nil then snapshot(s, p) end
    local refresh = now >= s.refreshAt
    if refresh then s.refreshAt = now + 0.45 + math_random() * 0.1 end

    if force then
        local y = math_floor(ang * 0.5 + 0.5) * 2
        local first = refresh or not s.aForce
        if first then plist_set(p, K_OFF, 0) end
        local write = first
        if not write then
            local last = s.aYaw
            if last == nil then
                write = true
            elseif last ~= y then
                if isTarget then
                    write = true
                else
                    local d = (y - last + 180) % 360 - 180
                    write = d >= 6 or d <= -6
                end
            end
        end
        if write then
            plist_set(p, K_YAW, y)
            s.aYaw = y
        end
        if first then
            plist_set(p, K_FORCE, true)
            s.aForce = true
        end
    elseif s.aForce then
        plist_set(p, K_FORCE, false)
        s.aForce = false
        s.aYaw = nil
    end

    if pf then
        local v = math_floor(pv + 0.5)
        if refresh or s.aPV ~= v then
            plist_set(p, K_PV, v)
            s.aPV = v
        end
        if refresh or not s.aPF then
            plist_set(p, K_PF, true)
            s.aPF = true
        end
    elseif s.aPF then
        plist_set(p, K_PF, false)
        s.aPF = false
        s.aPV = nil
    end

    local saved = s.saved
    local bv = baim and "Force" or saved[1]
    if s.aBaim ~= bv or (refresh and baim) then
        plist_set(p, K_BAIM, bv)
        s.aBaim = bv
    end
    local sv = safe and "Force" or saved[2]
    if s.aSafe ~= sv or (refresh and safe) then
        plist_set(p, K_SAFE, sv)
        s.aSafe = sv
    end
end

local function release(s)
    local saved = s.saved
    if saved == nil then return end
    local p = s.player
    if s.aForce then pcall(plist_set, p, K_FORCE, false) end
    if s.aPF then pcall(plist_set, p, K_PF, false) end
    if s.aBaim ~= saved[1] then pcall(plist_set, p, K_BAIM, saved[1]) end
    if s.aSafe ~= saved[2] then pcall(plist_set, p, K_SAFE, saved[2]) end
    s.saved = nil
    s.aForce = false
    s.aYaw = nil
    s.aPF = false
    s.aPV = nil
    s.aBaim = nil
    s.aSafe = nil
    s.hyp = 0
    s.baim = false
    s.safe = false
end

local function refreshIdentity(s, p, name, tickN)
    local R = Resolver
    s.infoAt = tickN
    if type(name) ~= "string" then
        local ok, n = pcall(readName, p)
        if ok and type(n) == "string" then name = n end
    end
    if type(name) == "string" and name ~= s.name then
        if s.name ~= nil and R.byName[s.name] == s then R.byName[s.name] = nil end
        s.name = name
        R.byName[name] = s
    end
    if get_slot ~= nil then
        local ok, slot = pcall(get_slot, p)
        if ok and type(slot) == "number" and slot ~= s.slot then
            if s.slot ~= nil and R.bySlot[s.slot] == s then R.bySlot[s.slot] = nil end
            s.slot = slot
            R.bySlot[slot] = s
        end
    end
end

local function decayScores(s, now)
    local elapsed = now - s.decayT
    s.decayT = now
    local f = 0.5 ^ (elapsed / 14)
    local score = s.score
    for i = 1, 4 * NH do
        local v = score[i]
        if v ~= 0 then score[i] = v * f end
    end
    local memT, memL, memE = s.memT, s.memL, s.memE
    for c = 1, 4 do
        if memT[c] > 0 and now - memT[c] > 40 then
            memT[c] = 0
            memL[c] = false
            memE[c] = false
        end
    end
end

local function headDelta(p, pos)
    local head = get_hitbox(p, "head")
    return head.Y - pos.Y
end

local function armsAxis(p)
    local l = get_hitbox(p, "left_arm")
    local r = get_hitbox(p, "right_arm")
    if l == nil or r == nil then return nil end
    local dx, dz = r.X - l.X, r.Z - l.Z
    if dx * dx + dz * dz < 0.04 then return nil end
    return math_atan2(dz, dx) * 57.29577951308232
end

local function armsFit(acc, axis, yaw)
    local best, bestR = 1, -1
    for k = 1, 2 do
        local sg = k == 1 and 1 or -1
        local a = (yaw - sg * axis) * 0.017453292519943295
        local t = acc[k]
        t[1] = t[1] * 0.995 + math_cos(a)
        t[2] = t[2] * 0.995 + math_sin(a)
        t[3] = t[3] * 0.995 + 1
        local r = math.sqrt(t[1] * t[1] + t[2] * t[2]) / t[3]
        if r > bestR then
            best = k
            bestR = r
        end
    end
    local t = acc[best]
    acc.sign = best == 1 and 1 or -1
    acc.shift = math_atan2(t[2], t[1]) * 57.29577951308232
    acc.n = t[3]
    acc.r = bestR
    local A = Arms
    local use = nil
    if A.truth.n >= 10 and A.truth.r >= 0.6 then
        use = A.truth
    elseif A.feet.n >= 25 and A.feet.r >= 0.6 then
        use = A.feet
    end
    if use ~= nil then
        A.ok = true
        A.sign = use.sign
        A.shift = use.shift
    else
        A.ok = false
    end
end

local function updateEnemy(s, p, now, tickN, isTarget, full, doResolve, mode, lethalThr, baimHp)
    local info = get_info(p)
    if info == nil or info.is_alive == false then
        s.alive = false
        return
    end
    local hp = info.health
    if type(hp) ~= "number" then hp = 100 end
    if hp <= 0 then
        s.alive = false
        return
    end
    local speed, inAir, duck = info.speed, info.is_in_air, info.is_crouching == true
    local dd, tw = info.desync_delta, info.twist_deg
    local yaw, pitch, lby, iname = info.yaw, info.pitch, info.lby, info.name
    local R = Resolver
    if R.vis then
        s.pos = info.position
        if R.wepOn then s.wep = info.weapon_name end
    end

    if not s.alive then
        s.alive = true
        s.life = s.life + 1
        newLife(s)
    end
    s.hp = hp
    s.crouch = duck
    if tickN - s.infoAt >= 128 then refreshIdentity(s, p, iname, tickN) end

    if R.vis and tickN >= s.sizeAt and get_hitbox ~= nil and s.pos ~= nil then
        s.sizeAt = tickN + 28 + s.life % 8
        local ok, dy = pcall(headDelta, p, s.pos)
        if ok and type(dy) == "number" then
            if dy > 3.2 and dy < 9 then
                s.foot = 0
            elseif dy > 0.3 then
                s.foot = 3
            end
        end
    end

    local body = false
    s.lethal = lethal

    if not doResolve then
        s.hyp = 0
        s.legit = true
        s.jitter = false
        s.flick = false
        s.fd = false
        s.baim = body
        s.safe = false
        if body or s.saved ~= nil then applyOverrides(s, p, false, 0, false, 0, body, false, now, isTarget) end
        return
    end

    if R.angleMode ~= 1 then
        local a, b, v = nil, nil, nil
        if get_angles ~= nil then a, b = get_angles(p) end
        if get_lby ~= nil then v = get_lby(p) end
        if R.angleMode == 0 then
            if get_angles == nil or get_lby == nil then
                R.angleMode = 2
            elseif type(a) == "number" and type(b) == "number" and type(v) == "number" and (b > 5 or b < -5) then
                if type(yaw) == "number" and type(pitch) == "number" and type(lby) == "number"
                    and math_abs(a - pitch) < 0.01 and math_abs(b - yaw) < 0.01 and math_abs(v - lby) < 0.01 then
                    R.angleSame = R.angleSame + 1
                    if R.angleSame >= 96 then R.angleMode = 1 end
                else
                    R.angleMode = 2
                end
            end
        end
        if a ~= nil and b ~= nil then
            pitch = a
            yaw = b
        end
        if v ~= nil then lby = v end
    end
    if type(yaw) ~= "number" or type(pitch) ~= "number" or type(lby) ~= "number"
        or yaw - yaw ~= 0 or pitch - pitch ~= 0 or lby - lby ~= 0 then
        s.hyp = 0
        s.legit = true
        s.baim = body
        s.safe = false
        applyOverrides(s, p, false, 0, false, 0, body, false, now, isTarget)
        return
    end
    yaw = (yaw + 180) % 360 - 180
    lby = (lby + 180) % 360 - 180
    if pitch > 89 then pitch = 89 elseif pitch < -89 then pitch = -89 end
    if type(speed) ~= "number" then speed = 0 end
    if type(dd) ~= "number" or dd - dd ~= 0 then
        dd = 0
    elseif dd > 86 then
        dd = 86
    elseif dd < -86 then
        dd = -86
    end
    if tw == nil and isTarget and get_twist ~= nil then tw = get_twist(p) end
    if type(tw) ~= "number" or tw - tw ~= 0 then tw = nil end

    local ctx = inAir and 4 or (duck and 3 or (speed > 2 and 2 or 1))
    if now - s.lastSample > 0.5 then resetHistory(s) end
    s.ctx = ctx
    s.lastSample = now
    if now - s.decayT >= 2 then decayScores(s, now) end

    local prev = s.prevYaw
    if prev ~= nil then
        local d = (yaw - prev + 180) % 360 - 180
        if d >= 25 or d <= -25 then
            local sign = d > 0 and 1 or -1
            local last = s.lastSign
            if last ~= 0 and last ~= sign then
                s.f3 = s.f2
                s.f2 = s.f1
                s.f1 = tickN
            end
            s.lastSign = sign
        end
    end
    s.prevYaw = yaw

    local hi = s.hi % 16 + 1
    s.hi = hi
    local rad = yaw * 0.017453292519943295
    local c, sn = math_cos(rad), math_sin(rad)
    local b = pitch < -45 and 1 or (pitch > 45 and 3 or 2)
    local hc, hs, hb, hv, pbc, pbs = s.hc, s.hs, s.hb, s.hv, s.pbc, s.pbs
    local hn = s.hn
    if hn == 16 then
        s.sumC = s.sumC - hc[hi]
        s.sumS = s.sumS - hs[hi]
        local ob = hb[hi]
        pbc[ob] = pbc[ob] - 1
        pbs[ob] = pbs[ob] - hv[hi]
    else
        hn = hn + 1
        s.hn = hn
    end
    hc[hi] = c
    hs[hi] = sn
    hb[hi] = b
    hv[hi] = pitch
    local sumC, sumS = s.sumC + c, s.sumS + sn
    s.sumC = sumC
    s.sumS = sumS
    pbc[b] = pbc[b] + 1
    pbs[b] = pbs[b] + pitch
    local ph = s.pHist
    local pn = #ph + 1
    if pn > 12 then
        for i = 1, 11 do ph[i] = ph[i + 1] end
        pn = 12
    end
    ph[pn] = pitch
    local pm = median(ph)
    if pm ~= nil then s.pMed = pm end

    local jitter = tickN - s.f3 <= 20
    if jitter then
        if s.jitSince == 0 then s.jitSince = now end
        s.jitSeen = now
        if now - s.jitSince >= 0.08 then s.jitConf = true end
    else
        s.jitSince = 0
        if now - s.jitSeen > 0.15 then s.jitConf = false end
    end
    local ref = yaw
    if jitter and sumC * sumC + sumS * sumS > 0.01 then
        ref = math_atan2(sumS, sumC) * 57.29577951308232
    end

    if duck ~= s.duck then
        s.duck = duck
        if now - s.duckT > 1.2 then
            s.duckT = now
            s.duckN = 1
        else
            s.duckN = s.duckN + 1
            if s.duckN >= 3 then
                s.fdUntil = now + 1.5
                s.duckT = now
                s.duckN = 0
            end
        end
    end
    local fd = now < s.fdUntil

    local sig = Resolver.aaSig(s, dd, jitter, yaw, prev)
    if s.sig == nil then
        s.sig, s.sigAt, s.sigLock = sig, tickN, sig
    elseif sig ~= s.sig then
        s.sig = sig
        s.sigAt = tickN
    elseif s.sigLock ~= sig and tickN - s.sigAt >= 20 then
        s.sigLock = sig
        Resolver.onAAChange(s, now)
    end

    local ca = s.ca
    local ml, me = s.memL[ctx], s.memE[ctx]
    ca[1] = ml and (lby + ml) or false
    ca[2] = me and (ref + me) or false
    ca[3] = lby
    if tw ~= nil and (tw >= 5 or tw <= -5) then
        ca[5] = lby + tw
        ca[11] = yaw + tw
    else
        ca[5] = false
        ca[11] = false
    end
    local hasDelta = dd >= 8 or dd <= -8
    ca[6] = false
    ca[7] = false
    if jitter then
        local e = (yaw - ref + 180) % 360 - 180
        if e >= 5 or e <= -5 then
            local m = hasDelta and math_abs(dd) or 58
            if e > 0 then
                ca[6] = yaw - m
                ca[7] = yaw + m
            else
                ca[6] = yaw + m
                ca[7] = yaw - m
            end
        end
    end
    ca[8] = ref
    if hasDelta then
        ca[9] = lby + dd
        ca[10] = lby - dd
        ca[13] = ref + dd
        ca[14] = ref - dd
    else
        ca[9] = false
        ca[10] = false
        ca[13] = false
        ca[14] = false
    end
    ca[15] = ref + 58
    ca[16] = ref - 58
    ca[17] = ref + 86
    ca[18] = ref - 86
    ca[19] = s.mirT[ctx] > now and (ref + s.mirO[ctx]) or false
    ca[4] = false
    ca[12] = false
    if isTarget and Resolver.animOK then
        local ok, anim = pcall(get_anim, p)
        if ok then
            if type(anim) == "table" then
                local g, t = anim.goal_feet_yaw, anim.torso_yaw
                if type(g) == "number" and g - g == 0 then
                    local e = (g - lby + 180) % 360 - 180
                    if e >= 6 or e <= -6 then ca[4] = g end
                end
                if type(t) == "number" and t - t == 0 then
                    local e1 = (t - lby + 180) % 360 - 180
                    local e2 = (t - ref + 180) % 360 - 180
                    if (e1 >= 6 or e1 <= -6) and (e2 >= 6 or e2 <= -6) then ca[12] = t end
                end
            end
        else
            Resolver.animFails = Resolver.animFails + 1
            if Resolver.animFails >= 3 then Resolver.animOK = false end
        end
    end
    local legit = false
    if Resolver.legitOK and not jitter and not hasDelta and dd < 5 and dd > -5 and now >= s.suspectUntil then
        local e = (lby - yaw + 180) % 360 - 180
        if e < 12 and e > -12 and (tw == nil or (tw < 5 and tw > -5)) then legit = true end
    end

    ca[20] = false
    s.arms = nil
    if isTarget and Arms.on then
        local ok, axis = pcall(armsAxis, p)
        if ok then
            if axis ~= nil then
                s.arms = axis
                if legit then
                    armsFit(Arms.truth, axis, yaw)
                elseif speed < 2 and not inAir then
                    armsFit(Arms.feet, axis, lby)
                end
                if Arms.ok then ca[20] = Arms.sign * axis + Arms.shift end
            end
        else
            Arms.fails = Arms.fails + 1
            if Arms.fails >= 3 then Arms.on = false end
        end
    end

    ca[21], ca[22], ca[23], ca[24] = false, false, false, false
    local ai = s.ai
    if mode == 4 and not legit then
        ai = Resolver.aiGet(s)
        local base = lby
        local pred = Resolver.aiPredict(ai, ctx)
        for i = 1, 4 do
            local ov = pred[i]
            if ov then
                ca[20 + i] = wrap180(base + ov)
                Resolver.aiRuns = (Resolver.aiRuns or 0) + 1
            end
        end
    end

    local hyp = s.hyp
    local ang = 0
    if legit then
        hyp = 0
    else
        if full or s.rescore or hyp == 0 or not ca[hyp] then
            s.rescore = false
            local base = (ctx - 1) * NH
            local score, block = s.score, s.block
            local pin = now < s.pinUntil and s.pin or 0
            local best, bestScore = 0, -1000000
            local famBase = (ctx - 1) * NF
            local fam = s.fam
            local famB = s.famB
            local wantJit = cfg.res_jit == false and jitter or s.jitConf
            for h = 1, NH do
                if ca[h] then
                    local sc = H_PRIOR[h] + G_BONUS[h] + score[base + h]
                    if block[base + h] > now then sc = sc - 12 end
                    if cfg.res_auto and fam[famBase + H_FAM[h]] ~= nil then
                        sc = sc + 0.6 * fam[famBase + H_FAM[h]]
                    end
                    if cfg.res_failed and failedHit(s, ctx, ca[h], now) then sc = sc - 12 end
                    if h == hyp then sc = sc + 0.3 end
                    if h == 8 and wantJit then sc = sc + 2.4 end
                    if h > 20 and ai ~= nil then sc = sc + 2.0 * ai.conf[h - 20] end
                    if h == pin then sc = sc + 30 end
                    local fb = famB[(ctx - 1) * NF + H_FAM[h]]
                    if fb ~= nil and fb > now then sc = sc - 8 end
                    if sc > bestScore then
                        best = h
                        bestScore = sc
                    end
                end
            end
            hyp = best
        end
        ang = (ca[hyp] + 180) % 360 - 180
    end

    local pf, pv = false, 0
    if not legit and hn >= 8 then
        local c1, c2, c3 = pbc[1], pbc[2], pbc[3]
        local mj, mc = 1, c1
        if c2 > mc then mj = 2; mc = c2 end
        if c3 > mc then mj = 3; mc = c3 end
        if mj ~= b and mc * 10 >= hn * 6 then
            pf = true
            if #s.pHist >= 6 and s.pMed == s.pMed then
                pv = s.pMed
            else
                pv = pbs[mj] / mc
            end
        end
    end

    if s.misses > 0 and now - s.lastMiss > 3 then
        s.misses = s.misses - 1
        s.lastMiss = now
    end
    local misses = s.misses
    local threshold = mode == 1 and 3 or (mode == 3 and 1 or 2)
    if misses >= threshold then
        local untilT = s.lastMiss + 4
        if untilT > s.baimUntil then s.baimUntil = untilT end
    end
    local baim = false
    local safe = false
    if cfg.res_safe == true then
        if legit then
            safe = fd
        elseif mode == 1 then
            safe = fd or misses >= 2
        elseif mode == 3 then
            safe = true
        else
            safe = fd or pf or misses >= 1
        end
    end

    s.yaw = yaw
    s.lby = lby
    s.ref = ref
    s.pitch = pitch
    s.jitter = jitter
    s.legit = legit
    s.fd = fd
    s.flick = pf
    s.hyp = hyp
    s.ang = ang
    s.baim = baim
    s.safe = safe

    applyOverrides(s, p, not legit, ang, pf, pv, baim, safe, now, isTarget)
end

local ENGINE_MODES = { [1] = "Adaptive", [2] = "Adaptive", [3] = "Freestanding", [4] = "Adaptive" }
function Resolver.syncEngine(on)
    local R = Resolver
    local wantOn = on == true and cfg.res == true
    if R.engOn == nil or R.engOn ~= wantOn then
        R.engOn = wantOn
        if has(rage, "set_resolver_enabled") then pcall(rage.set_resolver_enabled, wantOn) end
    end
    if not wantOn then
        if R.engBoxes ~= nil and has(rage, "override_hitboxes") then
            R.engBoxes = nil
            pcall(rage.override_hitboxes, { "head", "chest", "pelvis", "arms", "legs" })
            pcall(rage.override_hitbox_priority, { "chest", "head", "pelvis" })
        end
        if R.engHead == true then
            R.engHead = false
            if has(rage, "override_hitbox_priority") then
                pcall(rage.override_hitbox_priority, { "chest", "head", "pelvis" })
            end
        end
        return
    end
    local mode = Resolver.modeNum()
    local wantMode = ENGINE_MODES[mode] or "Adaptive"
    if R.engMode ~= wantMode then
        R.engMode = wantMode
        if has(rage, "set_resolver_mode") then pcall(rage.set_resolver_mode, wantMode) end
    end
    local wantLim = cfg.cycle_after
    if type(wantLim) ~= "number" or wantLim < 1 then wantLim = 2 end
    if wantLim > 5 then wantLim = 5 end
    if R.engLim ~= wantLim then
        R.engLim = wantLim
        if has(rage, "set_resolver_miss_limit") then pcall(rage.set_resolver_miss_limit, wantLim) end
    end
    local wantBaim = 0
    if R.engBaim ~= wantBaim then
        R.engBaim = wantBaim
        if has(rage, "set_resolver_baim_after_misses") then pcall(rage.set_resolver_baim_after_misses, wantBaim) end
    end
    if has(rage, "override_hitbox_priority") and R.engHead ~= true then
        R.engHead = true
        R.engBoxes = nil
    end
    local aim = cfg.res_aim
    if type(aim) ~= "string" then aim = "Head + neck" end
    local wantBox = aim == "Head" and 1 or (aim == "Head, chest, pelvis" and 3 or 2)
    if R.engBoxes ~= wantBox then
        R.engBoxes = wantBox
        if wantBox == 1 then
            pcall(rage.override_hitboxes, { "head" })
            pcall(rage.override_hitbox_priority, { "head" })
        elseif wantBox == 2 then
            pcall(rage.override_hitboxes, { "head", "chest" })
            pcall(rage.override_hitbox_priority, { "head", "chest" })
        else
            pcall(rage.override_hitboxes, { "head", "chest", "pelvis" })
            pcall(rage.override_hitbox_priority, { "head", "chest", "pelvis" })
        end
        if has(rage, "set_hitbox_config") then
            if wantBox >= 2 then
                pcall(rage.set_hitbox_config, "chest", { min_damage = 45, hitchance = 60, multipoint = true })
            end
            if wantBox >= 3 then
                pcall(rage.set_hitbox_config, "pelvis", { min_damage = 60, hitchance = 70, multipoint = false })
            end
        end
        if has(rage, "override_hitbox_min_damage") then
            pcall(rage.override_hitbox_min_damage, "chest", wantBox >= 2 and 45 or 100)
            pcall(rage.override_hitbox_min_damage, "pelvis", wantBox >= 3 and 60 or 100)
        end
    end
end

function Resolver.modeNum()
    local m = cfg.res_mode
    if m == "Aggressive" then return 1 end
    if m == "Safe" then return 3 end
    if m == "AI" then return 4 end
    return 2
end

function Resolver.tick(now, tickN)
    local R = Resolver
    local sample = tickN % 8 == 0
    local t0 = sample and clock() or 0
    R.active = true
    R.lastTick = tickN
    local doResolve = cfg.res == true
    local mode = Resolver.modeNum()
    local lethalThr = Rage.lethalThr
    local baimHp = cfg.baimhp and cfg.baimhp_val or 0
    R.wepOn = cfg.thud == true
    R.vis = R.wepOn or cfg.kfx == true
    local live, liveN = R.live, 0

    local states = R.states
    local tgt = rage.get_target()
    local tkey, tslot = nil, nil
    if type(tgt) == "table" then
        local tp = tgt.player
        tslot = tgt.slot
        if tp ~= nil then
            tkey = keyOf(tp)
        elseif tslot ~= nil then
            local ts = R.bySlot[tslot]
            if ts ~= nil then tkey = ts.key end
        end
    end

    local enemies = get_enemies()
    local stride = R.stride
    local target = nil
    if enemies ~= nil then
        for i = 1, #enemies do
            local p = enemies[i]
            local key = keyOf(p)
            if key ~= nil then
                local s = states[key]
                if s == nil then
                    s = newState(key, p, now)
                    states[key] = s
                end
                s.player = p
                s.seen = tickN
                local isTarget = key == tkey
                if isTarget then target = s end
                updateEnemy(s, p, now, tickN, isTarget, isTarget or stride == 1 or (tickN + i) % stride == 0, doResolve, mode, lethalThr, baimHp)
                if s.alive then
                    liveN = liveN + 1
                    live[liveN] = s
                end
            end
        end
    end
    for i = liveN + 1, R.liveN do live[i] = nil end
    R.liveN = liveN
    R.target = target
    if target ~= nil and type(tslot) == "number" and target.slot == nil then
        target.slot = tslot
        R.bySlot[tslot] = target
    end

    if tickN % 32 == 0 then Resolver.sweepDT(now) end

    if tickN % 64 == 0 then
        for key, s in pairs(states) do
            if tickN - s.seen > 64 or tickN < s.seen then
                release(s)
                states[key] = nil
                if s.name ~= nil and R.byName[s.name] == s then R.byName[s.name] = nil end
                if s.slot ~= nil and R.bySlot[s.slot] == s then R.bySlot[s.slot] = nil end
            end
        end
    end

    if sample then
        local cost = clock() - t0
        cost = R.cost + (cost - R.cost) * 0.25
        R.cost = cost
        if tickN % 32 == 0 then
            R.stride = cost < 0.0008 and 1 or (cost < 0.0016 and 2 or (cost < 0.003 and 3 or 4))
        end
    end
end

function Resolver.releaseAll()
    local R = Resolver
    R.active = false
    R.target = nil
    for i = 1, R.liveN do R.live[i] = nil end
    R.liveN = 0
    for _, s in pairs(R.states) do release(s) end
end

function Resolver.resetMemory()
    local R = Resolver
    R.aiMem = {}
    R.aiMemN = 0
    R.aiRuns = 0
    R.aiLive = 0
    for _, s in pairs(R.states) do
        s.ai = nil
        local score, block = s.score, s.block
        for i = 1, 4 * NH do
            score[i] = 0
            block[i] = 0
        end
        for c = 1, 4 do
            s.memL[c] = false
            s.memE[c] = false
            s.memT[c] = 0
            s.mirO[c] = 0
            s.mirT[c] = 0
        end
        s.misses = 0
        s.streak = 0
        s.ab = 0
        s.abNext = 4
        s.pin = 0
        s.pinUntil = 0
        s.baimUntil = 0
        s.suspectUntil = 0
        s.legitMiss = 0
        s.rescore = true
    end
    for h = 1, NH do
        G_HIT[h] = 0
        G_MISS[h] = 0
        G_BONUS[h] = 0
    end
    R.hits = 0
    R.misses = 0
    R.legitOK = true
    R.legitHit = 0
    R.legitMiss = 0
    Arms.ok = false
    for k = 1, 2 do
        local a, b = Arms.truth[k], Arms.feet[k]
        a[1] = 0
        a[2] = 0
        a[3] = 0
        b[1] = 0
        b[2] = 0
        b[3] = 0
    end
    Arms.truth.n = 0
    Arms.feet.n = 0
    Resolver.saveStats()
    if has(rage, "reset_resolver_state") then pcall(rage.reset_resolver_state) end
end

function Resolver.fromTarget(t)
    if t == nil then return nil end
    local R = Resolver
    local s = R.states[keyOf(t)]
    if s ~= nil then return s end
    local tp = type(t)
    if tp == "number" then
        return R.bySlot[t]
    elseif tp == "string" then
        s = R.byName[t]
        if s == nil then
            local n = tonumber(t)
            if n ~= nil then s = R.bySlot[n] end
        end
        return s
    end
    return nil
end

function Resolver.feedback(rec, hit, head, resolverMiss, now)
    local R = Resolver
    local s = rec.s
    if s == nil or s.life ~= rec.life or R.states[s.key] ~= s then return end
    local hyp = rec.hyp

    if hyp == 0 then
        if not rec.legit then return end
        if resolverMiss then
            s.legitMiss = s.legitMiss + 1
            local hold = 10 * s.legitMiss
            if hold > 120 then hold = 120 end
            s.suspectUntil = now + hold
            s.misses = s.misses + 1
            s.streak = s.streak + 1
            s.lastMiss = now
            R.misses = R.misses + 1
            R.legitMiss = R.legitMiss + 1
            if R.legitMiss >= 6 and R.legitMiss > R.legitHit then R.legitOK = false end
            local ctx, ca, ang = rec.ctx, rec.ca, rec.ang
            for h = 1, NH do
                local a = ca[h]
                if a then
                    local d = (a - ang + 180) % 360 - 180
                    if d < 10 and d > -10 then bump(s, ctx, h, -2, now + 3) end
                end
            end
            local off = wrap180(ang - rec.ref)
            if off >= 10 or off <= -10 then
                for c = 1, 4 do
                    s.mirO[c] = -off
                    s.mirT[c] = now + 5
                end
            end
            s.rescore = true
            R.dirty = true
        elseif hit and head then
            R.hits = R.hits + 1
            R.legitHit = R.legitHit + 1
            R.dirty = true
            if cfg.res_mode == "AI" then
                Resolver.aiObserve(Resolver.aiGet(s), wrap180(rec.ang - rec.lby), rec.ctx)
                Resolver.aiLive = (Resolver.aiLive or 0) + 1
            end
        end
        return
    end

    local ctx = rec.ctx
    local ca, ang = rec.ca, rec.ang

    if hit then
        if head then
            R.hits = R.hits + 1
            s.misses = 0
            s.streak = 0
            s.ctxMiss[ctx] = 0
            if rec.retry and rec.head and s.ab < 3 then s.ab = s.ab + 1 end
            s.pin = 0
            if rec.arms ~= nil then armsFit(Arms.truth, rec.arms, ang) end
            for h = 1, NH do
                local a = ca[h]
                if a then
                    local d = (a - ang + 180) % 360 - 180
                    if d < 10 and d > -10 then
                        bump(s, ctx, h, h == hyp and 2 or 1.25, 0)
                        G_HIT[h] = G_HIT[h] + 1
                        recalcBonus(h)
                    end
                end
            end
            local memL, memE, memT = s.memL, s.memE, s.memT
            if hyp == 6 or hyp == 7 then
                memL[ctx] = false
                memE[ctx] = false
                memT[ctx] = 0
            else
                local offL, offE = wrap180(ang - rec.lby), wrap180(ang - rec.ref)
                for c = 1, 4 do
                    if c == ctx or memT[c] == 0 then
                        memL[c] = offL
                        memE[c] = offE
                        memT[c] = now
                    end
                end
            end
            if cfg.res_failed then
                local list = s.failed
                for i = #list, 1, -1 do
                    local f = list[i]
                    local d = (f.a - ang + 180) % 360 - 180
                    if d < 3 and d > -3 then table_remove(list, i) end
                end
            end
            if cfg.res_auto and hyp >= 1 then
                local k = (ctx - 1) * NF + H_FAM[hyp]
                s.fam[k] = (s.fam[k] or 0) + 1.5
            end
            if cfg.res_mode == "AI" then
                Resolver.aiObserve(Resolver.aiGet(s), wrap180(ang - rec.lby), ctx)
                Resolver.aiLive = (Resolver.aiLive or 0) + 1
            end
            s.rev[ctx] = s.rev[ctx] + 1
            R.dirty = true
        elseif rec.head then
            bump(s, ctx, hyp, -0.75, nil)
        end
        return
    end

    if not resolverMiss then return end
    if rec.rev ~= s.rev[ctx] then return end
    s.rev[ctx] = s.rev[ctx] + 1
    R.misses = R.misses + 1
    s.rescore = true
    R.dirty = true

    if cfg.res_failed then
        local list = s.failed
        list[#list + 1] = { a = ang, p = s.pitch, b = not rec.head, c = ctx, e = now + 3 }
        if #list > 16 then table_remove(list, 1) end
    end
    if cfg.res_auto and hyp >= 1 then
        local k = (ctx - 1) * NF + H_FAM[hyp]
        s.fam[k] = (s.fam[k] or 0) - 1
    end
    if hyp >= 1 then
        s.famB[(ctx - 1) * NF + H_FAM[hyp]] = now + 1.2
        if hyp > 20 then
            local ai = Resolver.aiGet(s)
            ai.conf[hyp - 20] = ai.conf[hyp - 20] * 0.3
            ai.misses = (ai.misses or 0) + 1
        end
    end

    if cfg.brute_cycle then
        local cm = s.ctxMiss[ctx] + 1
        s.ctxMiss[ctx] = cm
        if cm % cfg.cycle_after == 0 then
            local stage = s.bruteStage[ctx] % 4 + 1
            s.bruteStage[ctx] = stage
            s.pin = 14 + stage
            s.pinUntil = now + 0.8
        end
    end

    local streak = s.streak + 1
    s.streak = streak
    if rec.head then
        if rec.retry then
            s.pin = 0
            if s.ab > 0 then s.ab = s.ab - 1 end
            if s.ab == 0 then
                local nextAt = streak * 2
                if nextAt > 64 then nextAt = 64 end
                s.abNext = nextAt
            end
        else
            if s.ab == 0 and streak >= s.abNext then s.ab = 1 end
            if s.ab >= 1 then
                s.pin = hyp
                s.pinUntil = now + 0.3
                return
            end
        end
    end
    s.misses = s.misses + 1
    s.lastMiss = now

    for h = 1, NH do
        local a = ca[h]
        if a then
            local d = (a - ang + 180) % 360 - 180
            if d < 10 and d > -10 then
                bump(s, ctx, h, h == hyp and -3 or -2, now + 3)
                G_MISS[h] = G_MISS[h] + 1
                recalcBonus(h)
                if h == 1 then s.memL[ctx] = false elseif h == 2 then s.memE[ctx] = false end
            end
        end
    end
    local off = wrap180(ang - rec.ref)
    local mirO, mirT = s.mirO, s.mirT
    for c = 1, 4 do
        if off >= 10 or off <= -10 then
            mirO[c] = -off
            mirT[c] = now + 5
        else
            mirT[c] = 0
        end
    end
    if off >= 10 or off <= -10 then
        s.pin = 19
        s.pinUntil = now + 0.6
        s.rescore = true
    end
end

local DT = { groups = {}, n = 0, serial = 0, completed = 0, expired = 0 }

function Resolver.closeDT(group)
    if group.closed then return end
    group.closed = true
    DT.groups[group.serial] = nil
    DT.n = DT.n - 1
    if group.s.dtLock == group then group.s.dtLock = nil end
end

function Resolver.trackDT(rec, now)
    local s = rec.s
    if s == nil then return end
    local group = s.dtLock
    if group == nil or group.closed or group.sent >= 2 or now >= group.lockUntil
        or group.ctx ~= rec.ctx or group.life ~= s.life or group.hyp ~= rec.hyp then
        if DT.n >= 32 then
            local oldest, oldestAt = nil, nil
            for _, g in pairs(DT.groups) do
                if oldestAt == nil or g.started < oldestAt then
                    oldest, oldestAt = g, g.started
                end
            end
            if oldest ~= nil then
                DT.expired = DT.expired + 1
                Resolver.closeDT(oldest)
            end
        end
        DT.serial = DT.serial + 1
        group = {
            serial = DT.serial, s = s, life = s.life, ctx = rec.ctx, hyp = rec.hyp,
            started = now, lockUntil = now + cfg.dt_window * 0.001, deadline = now + 2,
            sent = 0, results = {}, closed = false,
        }
        DT.groups[DT.serial] = group
        DT.n = DT.n + 1
        s.dtLock = group
    end
    group.sent = group.sent + 1
    rec.dtGroup = group
end

function Resolver.finishDT(group, now)
    local results = group.results
    local hitRec, missRec = nil, nil
    for i = 1, #results do
        local r = results[i]
        if r.hit then
            if hitRec == nil or (r.head and not hitRec.head) then hitRec = r end
        elseif r.resolverMiss then
            missRec = r
        end
    end
    DT.completed = DT.completed + 1
    Resolver.closeDT(group)
    if hitRec ~= nil then
        Resolver.feedback(hitRec.rec, true, hitRec.head, false, now)
    elseif missRec ~= nil then
        Resolver.feedback(missRec.rec, false, missRec.head, true, now)
    end
end

function Resolver.result(rec, hit, head, resolverMiss, now)
    local group = rec.dtGroup
    if group == nil or group.closed then
        Resolver.feedback(rec, hit, head, resolverMiss, now)
        return
    end
    rec.dtGroup = nil
    local results = group.results
    results[#results + 1] = { rec = rec, hit = hit, head = head, resolverMiss = resolverMiss }
    if #results < group.sent then
        if now >= group.deadline then
            DT.expired = DT.expired + 1
            Resolver.closeDT(group)
        end
        return
    end
    if group.sent < 2 and now < group.lockUntil then return end
    Resolver.finishDT(group, now)
end

function Resolver.sweepDT(now)
    for _, g in pairs(DT.groups) do
        if #g.results >= g.sent and (g.sent >= 2 or now >= g.lockUntil) then
            Resolver.finishDT(g, now)
        elseif now >= g.deadline then
            DT.expired = DT.expired + 1
            Resolver.closeDT(g)
        end
    end
end

function Resolver.describe(s)
    local hyp = s.hyp
    if hyp == 0 then return "OFF", 0 end
    local off = math_floor(wrap180(s.ang - s.yaw) + 0.5)
    local label = H_LABEL[hyp]
    if hyp == 8 and s.jitter then label = "JIT" end
    local level = 0
    if s.misses > 0 then level = 2 elseif hyp <= 2 then level = 1 end
    return label .. " " .. (off >= 0 and "+" or "") .. off .. "°", level
end

function Resolver.printStats()
    local R = Resolver
    if R.hits + R.misses == 0 then return end
    local order, hit, miss = {}, {}, {}
    for h = 1, NH do
        local label = H_LABEL[h]
        if hit[label] == nil then
            hit[label] = 0
            miss[label] = 0
            order[#order + 1] = label
        end
        hit[label] = hit[label] + G_HIT[h]
        miss[label] = miss[label] + G_MISS[h]
    end
    local parts = {}
    for i = 1, #order do
        local label = order[i]
        if hit[label] + miss[label] >= 0.5 then
            parts[#parts + 1] = label .. " " .. math_floor(hit[label] + 0.5) .. ":" .. math_floor(miss[label] + 0.5)
        end
    end
    log("resolver: " .. R.hits .. " head hits, " .. R.misses .. " resolver misses this session")
    if #parts > 0 then log("hypotheses (hit:miss)  " .. table_concat(parts, "  ")) end
end

function Resolver.loadStats()
    local data = dbRead(DB_RESOLVER)
    if type(data) ~= "table" or data.v ~= 1 or type(data.hit) ~= "table" or type(data.miss) ~= "table" then return end
    for h = 1, NH do
        local a = tonumber(data.hit[h] or data.hit[tostring(h)])
        local b = tonumber(data.miss[h] or data.miss[tostring(h)])
        if a ~= nil and b ~= nil and a >= 0 and b >= 0 then
            G_HIT[h] = a * 0.6
            G_MISS[h] = b * 0.6
            recalcBonus(h)
        end
    end
    local lh, lm = tonumber(data.legitHit), tonumber(data.legitMiss)
    if lh ~= nil and lm ~= nil then
        Resolver.legitHit = lh * 0.6
        Resolver.legitMiss = lm * 0.6
        if Resolver.legitMiss >= 6 and Resolver.legitMiss > Resolver.legitHit then Resolver.legitOK = false end
    end
end

function Resolver.saveStats()
    local R = Resolver
    R.dirty = false
    local hit, miss = {}, {}
    for h = 1, NH do
        local a, b = G_HIT[h], G_MISS[h]
        if a + b > 200 then
            local k = 200 / (a + b)
            a = a * k
            b = b * k
            G_HIT[h] = a
            G_MISS[h] = b
        end
        hit[h] = math_floor(a * 100 + 0.5) / 100
        miss[h] = math_floor(b * 100 + 0.5) / 100
    end
    dbWrite(DB_RESOLVER, { v = 1, hit = hit, miss = miss, legitHit = R.legitHit, legitMiss = R.legitMiss })
end

isHead = function(hitbox)
    if type(hitbox) == "string" then
        return string_find(string_lower(hitbox), "head", 1, true) ~= nil
    end
    return hitbox == 1
end

isBody = function(hitbox)
    if type(hitbox) == "string" then
        local h = string_lower(hitbox)
