            if type(id) == "string" then id = tonumber(id) or id end
            if type(id) == "number" or type(id) == "string" then EV.id = id end
            return
        end
    end
    EV.target = a
    if type(b) == "string" then
        if REASONS[string_lower(b)] then EV.reason = b else EV.hitbox = b end
    elseif type(b) == "number" then
        EV.hitbox = b
    end
    if type(c) == "number" then EV.damage = c end
    if type(d) == "string" then
        EV.reason = d
    elseif type(c) == "string" then
        EV.reason = c
    end
end

