local Anim = { list = {}, n = 0 }

local function ease(id, t)
    if id == 2 then
        local u = 1 - t
        return 1 - u * u * u
    elseif id == 3 then
        local u = 1 - t
        return 1 - u * u * u * u * u
    elseif id == 4 then
        if t < 0.5 then return 4 * t * t * t end
        local u = -2 * t + 2
        return 1 - u * u * u * 0.5
    elseif id == 5 then
        local u = t - 1
        return 1 + 2.70158 * u * u * u + 1.70158 * u * u
    elseif id == 7 then
        return 1 - 2 ^ (-10 * t)
    elseif id == 8 then
        if t < 0.5 then return 16 * t * t * t * t * t end
        local u = -2 * t + 2
        return 1 - u * u * u * u * u * 0.5
    elseif id == 9 then
        return t * t * t * t
    end
    return t
end

function Anim.new(value)
    return { v = value, a = value, b = value, t0 = 0, d = 0, e = 1, on = false, dirty = true }
end

function Anim.to(o, target, duration, easeId, delay, now)
    o.a = o.v
    o.b = target
    o.d = duration
    o.e = easeId or 3
    o.t0 = (now or clock()) + (delay or 0)
    if not o.on then
        o.on = true
        local n = Anim.n + 1
        Anim.n = n
        Anim.list[n] = o
    end
end

function Anim.set(o, value)
    o.v = value
    o.a = value
    o.b = value
    o.d = 0
    o.t0 = 0
    o.dirty = true
end

function Anim.step(now)
    local list, n = Anim.list, Anim.n
    local i = 1
    while i <= n do
        local o = list[i]
        local t = now - o.t0
        if t >= o.d then
            o.v = o.b
            o.on = false
            o.dirty = true
            list[i] = list[n]
            list[n] = nil
            n = n - 1
        else
            if t > 0 then
                o.v = o.a + (o.b - o.a) * ease(o.e, t / o.d)
                o.dirty = true
            end
            i = i + 1
        end
    end
    Anim.n = n
end

