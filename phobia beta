local function portrait(s)
    local key = s.key
    if type(key) == "number" and key > 0 and key == math_floor(key) then
        return "rbxthumb://type=AvatarHeadShot&id=" .. string_format("%d", key) .. "&w=150&h=150"
    end
    return ""
end

local function thudTexts(T, s, now)
    T.next = now + 0.1
    local name, sub, hpText, frac, rate
    if s == nil then
        name, sub, hpText, frac, rate = "No target", "waiting for the ragebot", "", 0, 1
    else
        name = s.name
        if type(name) ~= "string" then name = "?" end
        local hp = clamp(math_floor(s.hp + 0.5), 0, 100)
        if not s.alive then hp = 0 end
        hpText = hp .. " hp"
        frac = hp / 100
        rate = hp > 60 and 1 or (hp > 30 and 2 or 3)
        if not s.alive then
            sub = "dead"
        elseif cfg.res and Resolver.active then
            sub = Resolver.describe(s)
            if s.baim then sub = sub .. (s.lethal and "  |  lethal" or "  |  baim") end
            if s.misses > 0 then sub = sub .. "  |  " .. s.misses .. (s.misses == 1 and " miss" or " misses") end
        else
            sub = type(s.wep) == "string" and s.wep or ""
        end
    end
    if name ~= T.tName then
        T.tName = name
        T.name.Text = name
        T.letter.Text = string.upper(string_sub(name, 1, 1))
    end
    local img = s ~= nil and portrait(s) or ""
    if img ~= T.tImg then
        T.tImg = img
        T.image.Image = img
    end
    if sub ~= T.tSub then
        T.tSub = sub
        T.sub.Text = sub
    end
    if hpText ~= T.tHp then
        T.tHp = hpText
        T.hp.Text = hpText
    end
    if frac ~= T.frac then
        T.frac = frac
        Anim.to(T.bar, frac, 0.28, 3, 0, now)
    end
    if rate ~= T.rate then
        T.rate = rate
        local c = rate == 1 and Theme.accent or (rate == 2 and C_FAIR or C_BAD)
        T.shine.Color = colorSeq3(c, mix(c, WHITE, 0.45), c)
    end
end

function TargetHud.render(now)
    local T = TargetHud
    local card = T.card
    if card == nil then return end
    local enabled = cfg.thud == true and State.ready
    local s = nil
    if enabled then
        local ts = Resolver.target
        if ts ~= nil and ts.alive then
            T.s = ts
            T.lostAt = now
        elseif T.s ~= nil and now - T.lostAt > 1.2 then
            T.s = nil
        end
        s = T.s
    else
        T.s = nil
    end
    local want = s ~= nil or (enabled and HUD.menuOpen)
    if want ~= T.on then
        T.on = want
        if want then
            card.Visible = true
            T.next = 0
            T.placeAt = 0
            Anim.set(T.slide, 14)
            Anim.to(T.slide, 0, 0.4, 3, 0, now)
            Anim.to(T.alpha, 1, 0.3, 2, 0, now)
        else
            Anim.to(T.alpha, 0, 0.22, 2, 0, now)
            Anim.to(T.slide, 10, 0.22, 2, 0, now)
        end
    end
    local a = T.alpha
    if a.dirty then
        a.dirty = false
        fadeApply(T.fade, a.v)
        if not T.on and not a.on then card.Visible = false end
    end
    if not T.on then return end

    if now >= T.next then thudTexts(T, s, now) end
    local b = T.bar
    if b.dirty then
        b.dirty = false
        T.fill.Size = UDim2.new(b.v, 0, 1, 0)
    end
    if now >= T.placeAt then
        T.placeAt = now + 1
        if Drag.active ~= T then Drag.place(T, now) end
    end
    local sl = T.slide
    if sl.dirty or T.moved then
        sl.dirty = false
        T.moved = false
        card.Position = UDim2.new(0, T.px, 0, T.py + sl.v)
    end
    if State.frame % 2 == 0 then
        T.shine.Offset = Vector2.new((now * 0.6) % 2 - 1, 0)
    end
end

